---
import '@fontsource-variable/public-sans';
import '@fontsource-variable/overpass';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileNav from '../components/MobileNav.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  schema?: object | object[];
  active?: 'home' | 'mapa' | 'gasolina-95' | 'diesel' | 'provincias' | '';
  robots?: string;
  footer?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogType = 'website',
  schema,
  active = '',
  robots = 'index, follow',
  footer = true,
} = Astro.props;

const siteName = 'Gasolineras en Línea';
const siteUrl = 'https://gasolinerasenlinea.es';

const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: siteUrl,
  inLanguage: 'es-ES',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const schemas = [webSite, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#14181F" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://a.basemaps.cartocdn.com" crossorigin />
    <link rel="preload" href="/fonts/DSEG7Classic-Bold.woff2" as="font" type="font/woff2" crossorigin />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[2000] btn-ink h-10">Saltar al contenido</a>
    <Header active={active} />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    {footer && <Footer />}
    <MobileNav active={active} />
  </body>
</html>

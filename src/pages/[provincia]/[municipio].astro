---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PriceTotem from '../../components/PriceTotem.astro';
import PriceMap from '../../components/PriceMap.astro';
import StationList from '../../components/StationList.astro';
import AdSlot from '../../components/AdSlot.astro';
import AmazonV16 from '../../components/AmazonV16.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import NightBand from '../../components/NightBand.astro';
import { loadAllProvinces, provincesMeta, townStats, type Municipality } from '../../lib/data';
import { fmtEuros, fmtPrice, stationUrl, type GasStation, type MapPoint } from '../../lib/stations';

export async function getStaticPaths() {
  const all = await loadAllProvinces();
  const paths = [];
  for (const prov of provincesMeta) {
    const detail = all.get(prov.slug)!;
    const byTown = new Map<string, GasStation[]>();
    for (const s of detail.all_stations) {
      if (!s.town_slug) continue;
      if (!byTown.has(s.town_slug)) byTown.set(s.town_slug, []);
      byTown.get(s.town_slug)!.push(s);
    }
    for (const muni of detail.municipalities) {
      const stations = byTown.get(muni.slug) || [];
      if (!stations.length) continue;
      paths.push({
        params: { provincia: prov.slug, municipio: muni.slug },
        props: {
          province: { name: prov.name, slug: prov.slug, ccaa: prov.ccaa, avgG95: prov.avg_gasolina95, avgDiesel: prov.avg_diesel },
          municipality: muni,
          stations,
          neighbors: detail.municipalities.filter((m) => m.slug !== muni.slug).sort((a, b) => b.count - a.count).slice(0, 12),
          updatedAt: detail.updated_at,
        },
      });
    }
  }
  return paths;
}

interface Props {
  province: { name: string; slug: string; ccaa: string; avgG95: number | null; avgDiesel: number | null };
  municipality: Municipality;
  stations: GasStation[];
  neighbors: Municipality[];
  updatedAt: string;
}

const { province, municipality, stations, neighbors, updatedAt } = Astro.props;
const name = municipality.name;
const stats = townStats(stations);
const avgG95 = stats.avgG95 ?? province.avgG95;
const avgDiesel = stats.avgDiesel ?? province.avgDiesel;

const by = (k: 'gasolina95' | 'diesel') =>
  stations.filter((s) => typeof s.prices?.[k] === 'number').sort((a, b) => (a.prices[k] as number) - (b.prices[k] as number));
const s95 = by('gasolina95');
const sD = by('diesel');
const best95 = s95[0];
const bestD = sD[0];
const open24 = stations.filter((s) => s.is_24h);
const spread = s95.length > 1 ? (s95[s95.length - 1].prices.gasolina95! - s95[0].prices.gasolina95!) * 50 : 0;

const points: MapPoint[] = stations.map((s) => [
  s.lat, s.lng, s.prices?.gasolina95 ?? null, s.prices?.diesel ?? null, stationUrl(s), s.brand, s.address, s.is_24h ? 1 : 0,
]);

const title = `Gasolineras más baratas en ${name} (${province.name}) hoy | Precios`;
const description = `Compara el precio de hoy en las ${stations.length} gasolineras de ${name}. Gasolina 95 desde ${fmtPrice(best95?.prices.gasolina95)} €/L y diésel desde ${fmtPrice(bestD?.prices.diesel)} €/L. Mapa, horarios y cómo llegar.`;

const faqs = [
  {
    question: `¿Cuál es la gasolinera más barata en ${name} hoy?`,
    answer: best95
      ? `Para gasolina 95, ${best95.brand} en ${best95.address} a ${fmtPrice(best95.prices.gasolina95)} €/L.${bestD ? ` Para diésel, ${bestD.brand} en ${bestD.address} a ${fmtPrice(bestD.prices.diesel)} €/L.` : ''}`
      : `Consulta los precios actualizados de las gasolineras de ${name} en el listado.`,
  },
  {
    question: `¿Hay gasolineras abiertas 24 horas en ${name}?`,
    answer: open24.length
      ? `Sí, ${open24.length} ${open24.length === 1 ? 'gasolinera abre' : 'gasolineras abren'} las 24 horas: ${open24.slice(0, 5).map((s) => `${s.brand} (${s.address})`).join(', ')}.`
      : `Ahora mismo ninguna gasolinera de ${name} figura con horario 24 horas. Consulta los municipios cercanos de ${province.name}.`,
  },
  {
    question: `¿Cuánto me ahorro eligiendo la más barata de ${name}?`,
    answer: spread > 0.5
      ? `Entre la gasolina 95 más cara y la más barata de ${name} hay ${fmtEuros(spread)} de diferencia en un depósito de 50 litros.`
      : `En ${name} los precios son muy parecidos entre gasolineras; compara con los municipios cercanos para ahorrar más.`,
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://gasolinerasenlinea.es/' },
      { '@type': 'ListItem', position: 2, name: `Gasolineras ${province.name}`, item: `https://gasolinerasenlinea.es/${province.slug}/` },
      { '@type': 'ListItem', position: 3, name: `Gasolineras ${name}`, item: `https://gasolinerasenlinea.es/${province.slug}/${municipality.slug}/` },
    ],
  },
];
---

<Layout title={title} description={description} schema={schema} active="provincias">
  <NightBand>
    <div class="wrap pt-6 pb-12 sm:pb-16">
      <Breadcrumbs dark items={[{ label: 'Inicio', href: '/' }, { label: province.name, href: `/${province.slug}/` }, { label: name }]} />
      <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_1fr] gap-8 lg:gap-14 items-end mt-8">
        <div>
          <p class="inline-flex items-center gap-2 h-8 px-3 rounded-lg bg-white/[0.07] ring-1 ring-white/10 text-[12.5px] font-semibold text-white/75 mb-5"><span class="live-dot"></span>{province.name} · actualizado {updatedAt.slice(0, 16)}</p>
          <h1 class="text-white text-[2.6rem] sm:text-[4.2rem] font-black leading-[0.98] tracking-[-0.045em]">Gasolineras en {name}</h1>
          <p class="text-[16.5px] sm:text-lg text-white/70 mt-5 max-w-xl leading-relaxed">
            {stations.length === 1 ? 'La única gasolinera' : `Las ${stations.length} gasolineras`} de {name}, de la más barata a la más cara.{' '}
            {spread > 0.5 && <>Elegir bien te ahorra hasta <b class="text-volt">{fmtEuros(spread)}</b> por depósito.</>}
          </p>
          <dl class="grid grid-cols-3 gap-2 mt-7 max-w-lg">
            <div class="rounded-xl bg-white/[0.07] ring-1 ring-white/10 p-3.5 border-l-4 border-l-fuel-g95"><dt class="text-[11.5px] font-semibold text-white/55">Media SP95</dt><dd class="price text-[22px] text-white">{fmtPrice(avgG95)}</dd></div>
            <div class="rounded-xl bg-white/[0.07] ring-1 ring-white/10 p-3.5 border-l-4 border-l-white/70"><dt class="text-[11.5px] font-semibold text-white/55">Media diésel</dt><dd class="price text-[22px] text-white">{fmtPrice(avgDiesel)}</dd></div>
            <div class="rounded-xl bg-white/[0.07] ring-1 ring-white/10 p-3.5 border-l-4 border-l-volt"><dt class="text-[11.5px] font-semibold text-white/55">Abiertas 24 h</dt><dd class="price text-[22px] text-white">{open24.length}</dd></div>
          </dl>
        </div>
        <PriceTotem
          title={`Lo más barato en ${name}`}
          rows={[
            { label: 'Gasolina 95', price: best95?.prices.gasolina95 ?? null, dot: '#149447', note: best95 ? `${best95.brand} · ${best95.address}` : 'Sin precio' },
            { label: 'Diésel', price: bestD?.prices.diesel ?? null, dot: '#14181F', note: bestD ? `${bestD.brand} · ${bestD.address}` : 'Sin precio' },
          ]}
        />
      </div>
    </div>
  </NightBand>

  <div class="wrap pt-10"><AdSlot slotId={`municipio-${province.slug}-${municipality.slug}-top`} /></div>

  <section class="wrap pt-10" aria-labelledby="list-title">
    <h2 id="list-title" class="text-[1.8rem] sm:text-[2.4rem] font-black tracking-[-0.035em] mb-5">Precios de hoy en {name}</h2>
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_22rem] xl:grid-cols-[1fr_26rem] gap-5 items-start">
      <div class="order-2 lg:order-1 min-w-0">
        <StationList id="muni-stations" stations={stations} avgG95={avgG95} avgDiesel={avgDiesel} />
      </div>
      <div class="order-1 lg:order-2 lg:sticky lg:top-20">
        <div class="rounded-2xl overflow-hidden ring-1 ring-ink-200 shadow-card">
          <PriceMap id="muni-map" source="all" points={points} class="h-64 sm:h-80 lg:h-[calc(100vh-7rem)] lg:max-h-[640px]" />
        </div>
      </div>
    </div>
  </section>

  {neighbors.length > 0 && (
    <section class="wrap pt-14" aria-labelledby="near-title">
      <div class="flex items-end justify-between gap-4 mb-4">
        <h2 id="near-title" class="text-[1.6rem] font-black tracking-[-0.03em]">Otros municipios de {province.name}</h2>
        <a href={`/${province.slug}/`} class="font-display text-[13px] font-bold text-road hover:text-road-deep inline-flex items-center gap-1 shrink-0">Ver todos <Icon name="arrow-right" class="w-3.5 h-3.5" /></a>
      </div>
      <ul class="flex gap-2 overflow-x-auto no-scrollbar pb-1 -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap">
        {neighbors.map((m) => (
          <li class="shrink-0">
            <a href={`/${province.slug}/${m.slug}/`} class="chip h-10">
              {m.name}{m.min_p95 && <span class="price text-[13px] text-ink-400">{fmtPrice(m.min_p95)}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="wrap pt-12"><AmazonV16 /></section>

  <Faq title={`Repostar en ${name}`} faqs={faqs} />
</Layout>

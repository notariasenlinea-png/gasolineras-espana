---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PriceTotem from '../../components/PriceTotem.astro';
import PriceMap from '../../components/PriceMap.astro';
import Leaderboard from '../../components/Leaderboard.astro';
import AdSlot from '../../components/AdSlot.astro';
import AmazonV16 from '../../components/AmazonV16.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import summary from '../../data/summary.json';
import { loadAllProvinces, provincesMeta, type ProvinceDetail } from '../../lib/data';
import { fmtPrice, type GasStation } from '../../lib/stations';

export async function getStaticPaths() {
  const all = await loadAllProvinces();
  return provincesMeta.map((p) => ({ params: { provincia: p.slug }, props: { province: p, detail: all.get(p.slug)! } }));
}

interface Props {
  province: (typeof provincesMeta)[number];
  detail: ProvinceDetail;
}

const { province, detail } = Astro.props;
const { name, ccaa, total_stations, avg_gasolina95, avg_diesel, min_gasolina95, min_diesel, top_municipalities } = province;
const nat = summary.national_averages;
const top95 = detail.cheapest_gasolina95 as GasStation[];
const topD = detail.cheapest_diesel as GasStation[];
const munis = [...detail.municipalities].sort((a, b) => b.count - a.count);
const open24 = detail.all_stations.filter((s) => s.is_24h).length;

const vsNat = (v: number | null, n: number) => {
  if (v === null) return undefined;
  const d = (v - n) * 100;
  return Math.abs(d) < 0.5 ? 'En la media de España' : `${d < 0 ? '−' : '+'}${Math.abs(d).toFixed(1).replace('.', ',')} cts vs media de España`;
};

const title = `Gasolineras más baratas en ${name} hoy | Precio gasolina y diésel`;
const description = `Precios de hoy en las ${total_stations} gasolineras de ${name}. Gasolina 95 desde ${fmtPrice(min_gasolina95)} €/L y diésel desde ${fmtPrice(min_diesel)} €/L. Mapa, ranking y precios por municipio con datos oficiales.`;

const faqs = [
  {
    question: `¿Cuál es la gasolinera más barata de ${name} hoy?`,
    answer: top95.length
      ? `Para gasolina 95, ${top95[0].brand} en ${top95[0].town} (${top95[0].address}) a ${fmtPrice(top95[0].prices.gasolina95)} €/L. Para diésel, ${topD[0]?.brand} en ${topD[0]?.town} a ${fmtPrice(topD[0]?.prices.diesel)} €/L.`
      : `Los precios se actualizan cada 2 horas con los datos oficiales del MITECO.`,
  },
  {
    question: `¿Cuánto cuesta de media la gasolina en ${name}?`,
    answer: `Hoy la gasolina 95 cuesta de media ${fmtPrice(avg_gasolina95)} €/L y el diésel ${fmtPrice(avg_diesel)} €/L en ${name}, frente a ${fmtPrice(nat.gasolina95)} € y ${fmtPrice(nat.diesel)} € de media en España.`,
  },
  {
    question: `¿Qué municipios de ${name} tienen más gasolineras?`,
    answer: `${top_municipalities.slice(0, 4).map((m) => `${m.name} (${m.count})`).join(', ')}.`,
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://gasolinerasenlinea.es/' },
      { '@type': 'ListItem', position: 2, name: `Gasolineras ${name}`, item: `https://gasolinerasenlinea.es/${province.slug}/` },
    ],
  },
];
---

<Layout title={title} description={description} schema={schema} active="provincias">
  <section class="wrap pt-6 pb-10 sm:pb-14">
    <Breadcrumbs items={[{ label: 'Inicio', href: '/' }, { label: 'Provincias', href: '/#provincias' }, { label: name }]} />
    <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_1fr] gap-8 lg:gap-12 items-end mt-6">
      <div>
        <p class="eyebrow mb-3"><span class="live-dot"></span>{ccaa} · actualizado {detail.updated_at.slice(0, 16)}</p>
        <h1 class="text-4xl sm:text-6xl font-extrabold leading-[1.02] tracking-[-0.035em]">Gasolineras en {name}</h1>
        <p class="text-[16px] sm:text-lg text-ink-500 mt-4 max-w-xl">
          Precios de hoy en las {total_stations} gasolineras de la provincia. Encuentra la más barata en el mapa o en tu municipio.
        </p>
        <div class="flex flex-wrap gap-2 mt-6">
          <a href="#ranking" class="tag-muted h-8 px-3 text-[12px]"><span class="w-2 h-2 rounded-full bg-fuel-g95"></span>SP95 desde <b class="text-ink">{fmtPrice(min_gasolina95)} €</b></a>
          <a href="#ranking" class="tag-muted h-8 px-3 text-[12px]"><span class="w-2 h-2 rounded-full bg-fuel-diesel"></span>Diésel desde <b class="text-ink">{fmtPrice(min_diesel)} €</b></a>
          <span class="tag-muted h-8 px-3 text-[12px]"><Icon name="clock" class="w-3.5 h-3.5" />{open24} abiertas 24 h</span>
        </div>
      </div>
      <PriceTotem
        title={`Precio medio en ${name}`}
        rows={[
          { label: 'Gasolina 95', price: avg_gasolina95, dot: '#16A34A', note: vsNat(avg_gasolina95, nat.gasolina95) },
          { label: 'Diésel', price: avg_diesel, dot: '#E5E7EB', note: vsNat(avg_diesel, nat.diesel) },
        ]}
      />
    </div>
  </section>

  <!-- Map + ranking -->
  <section id="ranking" class="wrap scroll-mt-24" aria-labelledby="rank-title">
    <div class="grid grid-cols-1 lg:grid-cols-[1.35fr_1fr] gap-4 sm:gap-5">
      <div class="card overflow-hidden">
        <PriceMap id="prov-map" source={`province:${province.slug}`} class="h-[380px] sm:h-[560px] lg:h-full lg:min-h-[640px]" />
      </div>
      <div>
        <div class="flex items-center justify-between gap-3 mb-3">
          <h2 id="rank-title" class="text-2xl font-bold">Top 10 más baratas</h2>
          <div class="seg" role="group" aria-label="Combustible del ranking">
            <button type="button" class="rank-tab" data-tab="g95" aria-pressed="true">SP95</button>
            <button type="button" class="rank-tab" data-tab="diesel" aria-pressed="false">Diésel</button>
          </div>
        </div>
        <div data-panel="g95"><Leaderboard title={`Gasolina 95 en ${name}`} fuel="gasolina95" stations={top95} avg={avg_gasolina95} /></div>
        <div data-panel="diesel" class="hidden"><Leaderboard title={`Diésel en ${name}`} fuel="diesel" stations={topD} avg={avg_diesel} /></div>
      </div>
    </div>
  </section>

  <div class="wrap pt-10"><AdSlot slotId={`provincia-${province.slug}-top`} /></div>

  <!-- Municipalities -->
  <section class="wrap pt-12 sm:pt-16" aria-labelledby="munis-title">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-5">
      <div>
        <p class="eyebrow mb-2">{munis.length} municipios</p>
        <h2 id="munis-title" class="text-3xl sm:text-4xl font-bold">Elige tu municipio</h2>
      </div>
      <div class="relative">
        <Icon name="search" class="w-4 h-4 text-ink-400 absolute left-3.5 top-1/2 -translate-y-1/2" />
        <input id="muni-filter" type="search" placeholder={`Buscar en ${name}`} aria-label="Buscar municipio" class="h-11 w-full sm:w-64 pl-10 pr-3 rounded-2xl bg-white border border-ink-200 text-[14px] focus:outline-none focus:border-ink" />
      </div>
    </div>
    <ul id="muni-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2">
      {munis.map((m) => (
        <li class="muni-item" data-name={m.name.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()}>
          <a href={`/${province.slug}/${m.slug}/`} class="group flex items-center justify-between gap-2 h-full p-3.5 rounded-2xl bg-white border border-ink-100 hover:border-ink-300 hover:shadow-card transition-all">
            <span class="min-w-0">
              <span class="block text-[14px] font-semibold truncate">{m.name}</span>
              <span class="block text-[12px] text-ink-400">{m.count} {m.count === 1 ? 'gasolinera' : 'gasolineras'}</span>
            </span>
            {m.min_p95 && <span class="price text-[15px] shrink-0">{fmtPrice(m.min_p95)}</span>}
          </a>
        </li>
      ))}
    </ul>
    <p id="muni-empty" class="hidden py-8 text-center text-ink-500 text-sm">No hay municipios con ese nombre.</p>
  </section>

  <section class="wrap pt-12"><AmazonV16 /></section>

  <Faq title={`Repostar en ${name}`} faqs={faqs} />
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.rank-tab').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('.rank-tab').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => p.classList.toggle('hidden', p.dataset.panel !== b.dataset.tab));
    }),
  );

  const input = document.getElementById('muni-filter') as HTMLInputElement | null;
  const items = document.querySelectorAll<HTMLElement>('.muni-item');
  input?.addEventListener('input', () => {
    const q = input.value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
    let shown = 0;
    items.forEach((it) => {
      const ok = !q || (it.dataset.name || '').includes(q);
      it.classList.toggle('hidden', !ok);
      if (ok) shown++;
    });
    document.getElementById('muni-empty')?.classList.toggle('hidden', shown > 0);
  });
</script>

---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BrandMark from '../../components/BrandMark.astro';
import PriceTotem from '../../components/PriceTotem.astro';
import PriceMap from '../../components/PriceMap.astro';
import StationCard from '../../components/StationCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import Icon from '../../components/Icon.astro';
import NightBand from '../../components/NightBand.astro';
import { loadAllProvinces, provincesMeta, townStats } from '../../lib/data';
import {
  DAY_NAMES,
  FUELS,
  cheaperThanPct,
  fmtEuros,
  fmtInterval,
  fmtPrice,
  haversineKm,
  isLowCost,
  mapsUrl,
  openingHoursSpecification,
  parseSchedule,
  slugify,
  stationSlug,
  stationUrl,
  toMapPoint,
  wazeUrl,
  type GasStation,
  type MapPoint,
} from '../../lib/stations';

export async function getStaticPaths() {
  const provinces = await loadAllProvinces();
  const paths = [];

  for (const meta of provincesMeta) {
    const detail = provinces.get(meta.slug);
    if (!detail) continue;
    const all = detail.all_stations || [];
    const muniNames = new Map((detail.municipalities || []).map((m) => [m.slug, m.name]));
    const sortedPrices = (list: GasStation[], k: 'gasolina95' | 'diesel') =>
      list.map((s) => s.prices?.[k]).filter((v): v is number => typeof v === 'number').sort((a, b) => a - b);
    const prov95 = sortedPrices(all, 'gasolina95');
    const provD = sortedPrices(all, 'diesel');

    const byTown = new Map<string, GasStation[]>();
    for (const s of all) {
      const key = s.town_slug || slugify(s.town);
      if (!byTown.has(key)) byTown.set(key, []);
      byTown.get(key)!.push(s);
    }

    for (const [townSlug, townStations] of byTown) {
      const stats = townStats(townStations);
      const town95 = sortedPrices(townStations, 'gasolina95');
      const townD = sortedPrices(townStations, 'diesel');
      const town = { name: muniNames.get(townSlug) || townStations[0].town, slug: townSlug, hasPage: muniNames.has(townSlug), ...stats };

      for (const station of townStations) {
        // Nearby stations (same province) with distance
        const near = all
          .filter((s) => s.id !== station.id)
          .map((s) => ({ s, km: haversineKm(station.lat, station.lng, s.lat, s.lng) }))
          .filter((x) => x.km <= 15)
          .sort((a, b) => a.km - b.km);
        const fuelKey = station.prices?.gasolina95 != null ? 'gasolina95' : 'diesel';
        const cheaperNear = near
          .filter((x) => typeof x.s.prices?.[fuelKey] === 'number')
          .slice(0, 25)
          .sort((a, b) => (a.s.prices[fuelKey] as number) - (b.s.prices[fuelKey] as number))
          .slice(0, 3);
        const mapPoints = [station, ...near.slice(0, 40).map((x) => x.s)].map(toMapPoint);

        const useTown = townStations.length >= 5;
        const p95 = station.prices?.gasolina95;
        const pD = station.prices?.diesel;
        const rank = {
          scope: useTown ? town.name : meta.name,
          g95: typeof p95 === 'number' ? cheaperThanPct(useTown ? town95 : prov95, p95) : null,
          diesel: typeof pD === 'number' ? cheaperThanPct(useTown ? townD : provD, pD) : null,
        };

        paths.push({
          params: { slug: stationSlug(station.brand, station.town, station.id) },
          props: {
            station,
            province: { name: meta.name, slug: meta.slug, ccaa: meta.ccaa, avgG95: meta.avg_gasolina95 as number | null, avgDiesel: meta.avg_diesel as number | null },
            town,
            related: cheaperNear.map((x) => ({ station: x.s, km: x.km })),
            mapPoints,
            rank,
            updatedAt: detail.updated_at,
          },
        });
      }
    }
  }
  return paths;
}

interface Props {
  station: GasStation;
  province: { name: string; slug: string; ccaa: string; avgG95: number | null; avgDiesel: number | null };
  town: { name: string; slug: string; hasPage: boolean; avgG95: number | null; avgDiesel: number | null; count: number };
  related: Array<{ station: GasStation; km: number }>;
  mapPoints: MapPoint[];
  rank: { scope: string; g95: number | null; diesel: number | null };
  updatedAt: string;
}

const { station, province, town, related, mapPoints, rank, updatedAt } = Astro.props;
const site = 'https://gasolinerasenlinea.es';
const url = `${site}${stationUrl(station)}`;
const p95 = station.prices?.gasolina95 ?? null;
const pD = station.prices?.diesel ?? null;
const lowCost = isLowCost(station.brand);
const week = parseSchedule(station.schedule);
const townUrl = town.hasPage ? `/${province.slug}/${town.slug}/` : `/${province.slug}/`;

const fuels = FUELS.filter((f) => typeof station.prices?.[f.key] === 'number');
const nonAdblue = fuels.filter((f) => f.key !== 'adblue').map((f) => station.prices[f.key] as number);
const priceRange = nonAdblue.length ? `${fmtPrice(Math.min(...nonAdblue))} € - ${fmtPrice(Math.max(...nonAdblue))} € /L` : undefined;

// Verdict: primary fuel percentile
const primary = rank.g95 !== null ? { label: 'gasolina 95', pct: rank.g95 } : rank.diesel !== null ? { label: 'diésel', pct: rank.diesel } : null;
const verdict = primary
  ? primary.pct >= 67
    ? { tone: 'low', head: 'Buen precio', text: `Más barata que el ${primary.pct} % de las gasolineras de ${rank.scope} en ${primary.label}.` }
    : primary.pct >= 34
      ? { tone: 'mid', head: 'Precio normal', text: `Más barata que el ${primary.pct} % de las gasolineras de ${rank.scope} en ${primary.label}.` }
      : { tone: 'high', head: 'Precio alto', text: `El ${100 - primary.pct} % de las gasolineras de ${rank.scope} son más baratas en ${primary.label}.` }
  : null;

const TANK = 50;
const comparisons = [
  { label: 'Gasolina 95', price: p95, muni: town.avgG95, prov: province.avgG95 },
  { label: 'Diésel', price: pD, muni: town.avgDiesel, prov: province.avgDiesel },
].filter((c) => c.price !== null) as Array<{ label: string; price: number; muni: number | null; prov: number | null }>;
const main = comparisons[0];
const mainSaving = main && main.prov !== null ? (main.prov - main.price) * TANK : null;

const cheapestLabel = p95 !== null ? `gasolina 95 a ${fmtPrice(p95)} €/L` : pD !== null ? `diésel a ${fmtPrice(pD)} €/L` : 'precios actualizados';
const title = `${station.brand} ${station.address}, ${town.name} | Precio gasolina y diésel hoy`;
const description = `Precios de hoy en ${station.brand} (${station.address}, ${town.name}): ${cheapestLabel}. Horario ${station.is_24h ? '24 horas' : station.schedule}, comparativa con la zona y cómo llegar.`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'GasStation',
    '@id': url,
    name: `${station.brand} ${town.name} - ${station.address}`,
    brand: { '@type': 'Brand', name: station.brand },
    url,
    address: {
      '@type': 'PostalAddress',
      streetAddress: station.address,
      addressLocality: station.town,
      addressRegion: province.name,
      ...(station.postal_code ? { postalCode: station.postal_code } : {}),
      addressCountry: 'ES',
    },
    geo: { '@type': 'GeoCoordinates', latitude: station.lat, longitude: station.lng },
    hasMap: mapsUrl(station.lat, station.lng),
    ...(priceRange ? { priceRange } : {}),
    ...(week ? { openingHoursSpecification: openingHoursSpecification(week) } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: province.name, item: `${site}/${province.slug}/` },
      { '@type': 'ListItem', position: 3, name: town.name, item: `${site}${townUrl}` },
      { '@type': 'ListItem', position: 4, name: `${station.brand} - ${station.address}`, item: url },
    ],
  },
];
---

<Layout title={title} description={description} canonical={url} schema={schema} active="">
  <NightBand>
    <div class="wrap pt-6">
      <Breadcrumbs dark items={[{ label: 'Inicio', href: '/' }, { label: province.name, href: `/${province.slug}/` }, { label: town.name, href: townUrl }, { label: `${station.brand} · ${station.address}` }]} />
    </div>

    <!-- Header -->
    <div class="wrap pt-8 pb-12 sm:pb-16 grid grid-cols-1 lg:grid-cols-[1.25fr_1fr] gap-8 lg:gap-12 items-start">
      <div class="min-w-0">
        <div class="flex items-start gap-4">
          <BrandMark brand={station.brand} size="lg" />
          <div class="min-w-0">
            <h1 class="text-white text-[2.2rem] sm:text-[3.4rem] font-black leading-[1] tracking-[-0.04em]">{station.brand} <span class="text-white/45">{town.name}</span></h1>
            <p class="mt-2.5 text-[15.5px] text-white/70">{station.address}, {station.postal_code ? `${station.postal_code} ` : ''}{station.town} ({province.name})</p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-2 mt-6">
          {station.is_24h ? (
            <span class="tag-24 h-8 px-3 text-[12px]"><span class="live-dot"></span>Abierta 24 horas</span>
          ) : week ? (
            <span id="open-status" data-week={JSON.stringify(week)} class="tag-muted h-8 px-3 text-[12px]"><Icon name="clock" class="w-3.5 h-3.5" /><span class="status-text">Ver horario</span></span>
          ) : (
            <span class="tag-muted h-8 px-3 text-[12px]"><Icon name="clock" class="w-3.5 h-3.5" />{station.schedule}</span>
          )}
          {lowCost && <span class="tag-lc h-8 px-3 text-[12px]"><Icon name="zap" class="w-3.5 h-3.5" />Low-cost</span>}
          <span class="tag h-8 px-3 text-[12px] bg-white/[0.08] text-white/85 ring-1 ring-white/15">{fuels.length} {fuels.length === 1 ? 'combustible' : 'combustibles'}</span>
        </div>

        {verdict && (
          <div class={`mt-7 rounded-2xl p-5 sm:p-6 lvl-${verdict.tone}`}>
            <p class="font-display text-[22px] font-black tracking-[-0.02em]">{verdict.head}</p>
            <p class="text-[15px] mt-1 opacity-90">{verdict.text}</p>
            <div class="relative mt-5 h-3 rounded-sm bg-gradient-to-r from-pricey via-fair to-cheap" aria-hidden="true">
              <span class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-3 h-7 rounded-sm bg-ink ring-2 ring-white shadow" style={`left:${Math.max(3, Math.min(97, primary!.pct))}%`}></span>
            </div>
            <div class="flex justify-between font-display text-[11px] font-extrabold uppercase tracking-wide mt-2 opacity-70"><span>Más cara</span><span>Más barata</span></div>
          </div>
        )}

        <div class="flex flex-wrap gap-2 mt-6">
          <a href="#como-llegar" class="btn-volt"><Icon name="navigation" class="w-4 h-4" /> Cómo llegar</a>
          <button type="button" id="share-btn" class="btn-ghost-dark"><Icon name="share" class="w-4 h-4" /> <span>Compartir</span></button>
        </div>
      </div>

      <PriceTotem
        title={`Precios en ${station.brand}`}
        subtitle={`Actualizado el ${updatedAt.slice(0, 16)}`}
        rows={fuels.map((f) => ({ label: f.label, price: station.prices[f.key] as number, dot: f.key === 'diesel' ? '#14181F' : f.dot }))}
        footer="Precio oficial comunicado al MITECO. Puede variar en el surtidor."
      />
    </div>
  </NightBand>

  <div class="wrap pt-10"><AdSlot slotId="ficha-top" /></div>

  <!-- Savings + schedule -->
  <section class="wrap pt-8 grid grid-cols-1 lg:grid-cols-[1.25fr_1fr] gap-4 sm:gap-5 items-start">
    {comparisons.length > 0 && (
      <div class="card p-5 sm:p-7" aria-labelledby="ahorro-title">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
          <h2 id="ahorro-title" class="text-[1.4rem] font-black tracking-[-0.025em]">¿Compensa repostar aquí?</h2>
          <label class="flex items-center gap-3 text-[13px] font-medium text-ink-500">
            Depósito
            <input id="tank-liters" type="range" min="20" max="90" step="5" value={TANK} class="w-28" />
            <output id="tank-liters-label" class="font-display font-bold text-ink w-10">{TANK} L</output>
          </label>
        </div>

        {mainSaving !== null && (
          <p class="text-[15px] mb-5">
            {mainSaving >= 0 ? 'Te ahorras ' : 'Pagas '}
            <strong class={`font-display text-2xl font-bold tabular-nums savings ${mainSaving >= 0 ? 'text-cheap-ink' : 'text-pricey-ink'}`} data-diff={(main.prov! - main.price).toFixed(4)}>{fmtEuros(Math.abs(mainSaving))}</strong>
            {mainSaving >= 0 ? '' : ' más'} por depósito de {main.label.toLowerCase()} respecto a la media de {province.name}.
          </p>
        )}

        <div class="grid sm:grid-cols-2 gap-3">
          {comparisons.map((c) => (
            <div class="rounded-xl bg-ink-50 p-4 border-t-4 border-road">
              <div class="flex items-baseline justify-between mb-3">
                <span class="text-[13px] font-semibold">{c.label}</span>
                <span class="price text-lg">{fmtPrice(c.price)} €</span>
              </div>
              {[{ label: `Media ${town.name}`, avg: c.muni }, { label: `Media ${province.name}`, avg: c.prov }].map((r) =>
                r.avg !== null && (
                  <div class="flex items-center justify-between gap-2 text-[13px] py-1">
                    <span class="text-ink-500 truncate">{r.label} <span class="tabular-nums">({fmtPrice(r.avg)})</span></span>
                    <span class={`font-semibold tabular-nums savings ${r.avg - c.price >= 0 ? 'text-cheap-ink' : 'text-pricey-ink'}`} data-diff={(r.avg - c.price).toFixed(4)} data-signed="1">
                      {r.avg - c.price >= 0 ? '−' : '+'}{fmtEuros(Math.abs((r.avg - c.price) * TANK))}
                    </span>
                  </div>
                )
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="card p-5 sm:p-7">
      <h2 class="text-[1.4rem] font-black tracking-[-0.025em] mb-4 flex items-center gap-2"><Icon name="calendar" class="w-5 h-5 text-road" /> Horario</h2>
      {week ? (
        <table class="w-full text-[14px]">
          <tbody class="divide-y divide-ink-100">
            {week.map((intervals, i) => (
              <tr data-day={i} class="schedule-row">
                <th scope="row" class="py-2 text-left font-medium text-ink-600">{DAY_NAMES[i]}</th>
                <td class="py-2 text-right tabular-nums">{intervals.length ? intervals.map(fmtInterval).join(' · ') : <span class="text-pricey-ink">Cerrado</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ) : (
        <p class="text-[15px]">{station.is_24h ? 'Abierta las 24 horas, todos los días.' : station.schedule}</p>
      )}
      <p class="text-[12px] text-ink-400 mt-4">Horario comunicado por la estación: «{station.schedule}».</p>
    </div>
  </section>

  <!-- Map -->
  <section id="mapa" class="wrap pt-8 scroll-mt-20">
    <div class="rounded-2xl overflow-hidden ring-1 ring-ink-200 shadow-card">
      <PriceMap id="ficha-map" source="all" points={mapPoints} focus={[station.lat, station.lng]} zoom={14} class="h-[340px] sm:h-[420px]" />
    </div>
  </section>

  <!-- Nearby cheaper -->
  {related.length > 0 && (
    <section class="wrap pt-12" aria-labelledby="near-title">
      <div class="flex items-end justify-between gap-4 mb-4">
        <div>
          <p class="sign mb-4">Alternativas</p>
          <h2 id="near-title" class="text-[1.8rem] sm:text-[2.4rem] font-black tracking-[-0.035em]">Las más baratas cerca de aquí</h2>
        </div>
        <a href={townUrl} class="font-display text-[13px] font-bold text-road hover:text-road-deep inline-flex items-center gap-1 shrink-0">Todas en {town.name} <Icon name="arrow-right" class="w-3.5 h-3.5" /></a>
      </div>
      <div class="grid gap-2">
        {related.map((r) => (
          <StationCard station={r.station} km={r.km} avgG95={town.avgG95} avgDiesel={town.avgDiesel} />
        ))}
      </div>
    </section>
  )}

  <div class="wrap pt-10"><AdSlot slotId="ficha-mid" /></div>

  <!-- Directions CTA -->
  <section id="como-llegar" class="wrap pt-10 pb-16 scroll-mt-20">
    <div class="relative overflow-hidden rounded-2xl bg-road text-white p-6 sm:p-10 shadow-sign">
      <div class="absolute inset-0 texture pointer-events-none"></div>
      <div class="absolute inset-2.5 rounded-xl ring-2 ring-white/80 pointer-events-none" aria-hidden="true"></div>
      <div class="relative grid md:grid-cols-[1.2fr_1fr] gap-6 items-center">
        <div>
          <h2 class="text-white text-3xl sm:text-[2.6rem] font-black tracking-[-0.035em]">¿Vas a repostar aquí?</h2>
          <p class="text-white/75 mt-2">{station.brand} · {station.address}, {station.town}</p>
        </div>
        <div class="grid gap-2.5">
          <a href={mapsUrl(station.lat, station.lng)} target="_blank" rel="noopener nofollow" class="btn-volt h-14 text-[15px]"><Icon name="navigation" class="w-5 h-5" /> Abrir en Google Maps</a>
          <a href={wazeUrl(station.lat, station.lng)} target="_blank" rel="noopener nofollow" class="btn-ghost-dark h-14 text-[15px]">Abrir en Waze</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sticky mobile action bar -->
  <div id="sticky-bar" class="md:hidden fixed inset-x-3 bottom-[4.6rem] z-[900] translate-y-24 opacity-0 transition-all duration-300">
    <div class="flex items-center gap-3 rounded-2xl bg-ink text-white p-2 pl-4 shadow-lift">
      <div class="min-w-0 flex-1">
        <p class="text-[12px] text-white/50 truncate">{station.brand} · {town.name}</p>
        <p class="led text-lg leading-tight">{fmtPrice(p95 ?? pD)} <span class="text-[11px] text-white/50 font-medium">{p95 !== null ? 'SP95' : 'Diésel'}</span></p>
      </div>
      <a href={mapsUrl(station.lat, station.lng)} target="_blank" rel="noopener nofollow" class="btn-volt h-11 px-4"><Icon name="navigation" class="w-4 h-4" /> Ir</a>
    </div>
  </div>
</Layout>

<script>
  import { isOpenAt, type WeekSchedule } from '../../lib/stations';

  // Live open/closed status + highlight today
  const status = document.getElementById('open-status');
  if (status?.dataset.week) {
    try {
      const week = JSON.parse(status.dataset.week) as WeekSchedule;
      const open = isOpenAt(week, new Date());
      status.className = `${open ? 'tag-24' : 'tag bg-pricey-soft text-pricey-ink'} h-8 px-3 text-[12px]`;
      const txt = status.querySelector('.status-text');
      if (txt) txt.textContent = open ? 'Abierta ahora' : 'Cerrada ahora';
    } catch {}
  }
  const today = (new Date().getDay() + 6) % 7;
  document.querySelector(`.schedule-row[data-day="${today}"]`)?.classList.add('font-bold', 'bg-volt-soft');

  // Tank slider
  const slider = document.getElementById('tank-liters') as HTMLInputElement | null;
  const label = document.getElementById('tank-liters-label');
  const eur = (v: number) => `${v.toFixed(2).replace('.', ',')} €`;
  slider?.addEventListener('input', () => {
    const l = Number(slider.value);
    if (label) label.textContent = `${l} L`;
    document.querySelectorAll<HTMLElement>('.savings').forEach((el) => {
      const d = Number(el.dataset.diff);
      el.textContent = el.dataset.signed ? `${d >= 0 ? '−' : '+'}${eur(Math.abs(d * l))}` : eur(Math.abs(d * l));
    });
  });

  // Share
  document.getElementById('share-btn')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const data = { title: document.title, url: location.href };
    try {
      if (navigator.share) await navigator.share(data);
      else {
        await navigator.clipboard.writeText(location.href);
        const span = btn.querySelector('span');
        if (span) span.textContent = 'Enlace copiado';
      }
    } catch {}
  });

  // Sticky bar after scrolling past the header
  const bar = document.getElementById('sticky-bar');
  const cta = document.getElementById('como-llegar');
  if (bar) {
    const onScroll = () => {
      const past = window.scrollY > 520;
      const atCta = cta ? cta.getBoundingClientRect().top < window.innerHeight : false;
      const show = past && !atCta;
      bar.classList.toggle('translate-y-24', !show);
      bar.classList.toggle('opacity-0', !show);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

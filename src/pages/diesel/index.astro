---
import Layout from '../../layouts/Layout.astro';
import GasolineraCard from '../../components/GasolineraCard.astro';
import AdSlot from '../../components/AdSlot.astro';
import summary from '../../data/summary.json';
import provinces from '../../data/provinces.json';

const { national_averages, cheapest_diesel, updated_at, total_stations } = summary;

// Sort provinces by cheapest diesel
const sortedProvinces = [...provinces]
  .filter((p) => p.min_diesel !== null)
  .sort((a, b) => (a.min_diesel || 99) - (b.min_diesel || 99));

const title = `Precio Diésel Hoy en España: ${national_averages.diesel} €/L | Gasóleo A Más Barato`;
const description = `Consulta en directo el precio del diésel (gasóleo A) hoy en España. Media nacional a ${national_averages.diesel} €/L y mínimo en ${national_averages.min_diesel} €/L. Ahorra en más de ${total_stations.toLocaleString('es-ES')} gasolineras con datos MITECO.`;

const faqs = [
  {
    question: '¿Cuál es el precio medio del diésel hoy en España?',
    answer: `El precio medio oficial del Gasóleo A habitual en las estaciones de servicio españolas hoy es de ${national_averages.diesel.toFixed(3)} € por litro.`
  },
  {
    question: '¿Dónde está el diésel más barato de España?',
    answer: `Hoy la estación con el diésel más barato de España se encuentra en ${cheapest_diesel[0]?.town} (${cheapest_diesel[0]?.province}) a un precio de ${national_averages.min_diesel.toFixed(3)} €/L en la estación ${cheapest_diesel[0]?.brand}.`
  },
  {
    question: '¿Qué diferencia hay entre el Gasóleo A y el Diésel Premium / Plus?',
    answer: 'El Gasóleo A es el combustible estándar para turismos y transporte. El diésel premium (Plus, Óptima, Ultimate) añade aditivos detergentes, anticorrosivos y mejoradores del índice de cetano para optimizar la combustión y mantener limpios los inyectores, con un sobrecoste habitual de entre 8 y 12 céntimos por litro.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map((f) => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<Layout title={title} description={description} schema={faqSchema} activeFuel="diesel">
  <!-- Hero -->
  <section class="bg-gradient-to-b from-sky-950/10 via-slate-50 to-slate-50 py-12 sm:py-16 border-b border-slate-200/90">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-100 text-sky-900 text-xs font-black uppercase tracking-wider mb-4 border border-sky-300 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-sky-600 animate-pulse"></span>
        Monitor Nacional Diésel A • {updated_at}
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-slate-950 tracking-tight mb-4">
        Precio del <span class="text-sky-700">Diésel (Gasóleo A) Hoy</span> en España
      </h1>

      <p class="text-base sm:text-lg text-slate-700 mb-8 leading-relaxed">
        Compara los precios del gasóleo en las más de {total_stations.toLocaleString('es-ES')} estaciones de España y encuentra las estaciones con los mejores precios en tu ruta.
      </p>

      <!-- KPI Bento Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 max-w-xl mx-auto text-left">
        <div class="bg-white rounded-2xl p-4 border border-slate-200/90 shadow-soft-card">
          <span class="text-xs text-slate-600 font-bold block">Media Nacional</span>
          <div class="flex items-baseline gap-1 my-1">
            <span class="text-2xl sm:text-3xl font-black text-slate-950 tabular-nums">{national_averages.diesel.toFixed(3)}</span>
            <span class="text-xs font-bold text-slate-500">€/L</span>
          </div>
          <span class="text-[11px] text-slate-500 font-medium">Promedio ponderado</span>
        </div>

        <div class="bg-sky-50/60 rounded-2xl p-4 border border-sky-300 shadow-soft-card">
          <span class="text-xs text-sky-900 font-bold block">Mínimo Nacional</span>
          <div class="flex items-baseline gap-1 my-1">
            <span class="text-2xl sm:text-3xl font-black text-sky-800 tabular-nums">{national_averages.min_diesel.toFixed(3)}</span>
            <span class="text-xs font-black text-sky-700">€/L</span>
          </div>
          <span class="text-[11px] text-sky-800 font-bold">¡Precio récord hoy!</span>
        </div>

        <div class="col-span-2 sm:col-span-1 bg-gradient-to-tr from-sky-700 via-sky-800 to-blue-900 rounded-2xl p-4 text-white shadow-md shadow-sky-900/20">
          <span class="text-xs text-sky-200 font-black uppercase tracking-wider block">Ahorro Máximo</span>
          <div class="flex items-baseline gap-1 my-1">
            <span class="text-2xl sm:text-3xl font-black text-white tabular-nums">{((national_averages.diesel - national_averages.min_diesel) * 50).toFixed(1)}</span>
            <span class="text-xs font-bold text-sky-200">€</span>
          </div>
          <span class="text-[11px] text-sky-100 font-medium">Depósito de 50L</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Ad Slot Top -->
  <AdSlot format="horizontal" slotId="diesel-top-banner" />

  <!-- Top 15 Cheapest Diésel Stations -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14" aria-labelledby="diesel-rank-title">
    <div class="mb-8">
      <span class="text-xs font-black text-sky-800 uppercase tracking-wider block">Ranking Oficial MITECO</span>
      <h2 id="diesel-rank-title" class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight">
        Las 15 Gasolineras con el Diésel Más Barato de España
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 mt-1">
        Estaciones ordenadas de menor a mayor precio por litro de Gasóleo A verificadas hoy.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {cheapest_diesel.map((st, i) => (
        <GasolineraCard
          station={st}
          rank={i + 1}
          avgGasolina95={national_averages.gasolina95}
          avgDiesel={national_averages.diesel}
          highlightFuel="diesel"
        />
      ))}
    </div>
  </section>

  <!-- Province Comparison Table for Diésel -->
  <section class="bg-white border-y border-slate-200/90 py-12 sm:py-16" aria-labelledby="diesel-prov-title">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 id="diesel-prov-title" class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight mb-2">
          Ranking de Provincias con el Diésel Más Barato
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          Clasificación de las provincias ordenadas por el precio mínimo de gasóleo verificado hoy.
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-slate-200/90 shadow-2xs max-w-4xl mx-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-slate-100 text-slate-700 font-black border-b border-slate-200">
              <th scope="col" class="py-3.5 px-4 text-center w-12">#</th>
              <th scope="col" class="py-3.5 px-4">Provincia</th>
              <th scope="col" class="py-3.5 px-4">Comunidad Autónoma</th>
              <th scope="col" class="py-3.5 px-4 text-right">Mínimo Diésel</th>
              <th scope="col" class="py-3.5 px-4 text-right">Media Diésel</th>
              <th scope="col" class="py-3.5 px-4 text-center">Acción</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            {sortedProvinces.map((p, idx) => (
              <tr class="hover:bg-sky-50/40 transition-colors">
                <td class="py-3 px-4 text-center font-bold text-slate-500">
                  {idx + 1}
                </td>
                <td class="py-3 px-4 font-bold text-slate-900">
                  <a href={`/${p.slug}/`} class="hover:text-sky-700 transition-colors">
                    {p.name}
                  </a>
                </td>
                <td class="py-3 px-4 text-slate-600">
                  {p.ccaa}
                </td>
                <td class="py-3 px-4 text-right font-black text-sky-800 text-sm tabular-nums">
                  {p.min_diesel ? `${p.min_diesel.toFixed(3)} €` : '-'}
                </td>
                <td class="py-3 px-4 text-right font-bold text-slate-700 tabular-nums">
                  {p.avg_diesel ? `${p.avg_diesel.toFixed(3)} €` : '-'}
                </td>
                <td class="py-3 px-4 text-center">
                  <a
                    href={`/${p.slug}/`}
                    class="inline-block px-3 py-1 rounded-xl bg-slate-100 hover:bg-sky-700 hover:text-white font-bold transition-colors text-[11px]"
                  >
                    Ver gasolineras
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16" aria-labelledby="faq-diesel">
    <h2 id="faq-diesel" class="text-2xl font-black text-slate-950 tracking-tight text-center mb-8">
      Preguntas Frecuentes sobre el Diésel
    </h2>
    <div class="space-y-4">
      {faqs.map((faq) => (
        <details class="group bg-white rounded-2xl border border-slate-200/90 p-5 open:shadow-soft-card transition-all">
          <summary class="flex items-center justify-between cursor-pointer list-none font-bold text-slate-900 group-open:text-sky-800 text-sm sm:text-base select-none focus:outline-none">
            <span>{faq.question}</span>
            <span class="ml-4 shrink-0 transition-transform duration-200 group-open:rotate-180 text-slate-500">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-3 text-xs sm:text-sm text-slate-700 leading-relaxed pt-3 border-t border-slate-100">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </section>
</Layout>

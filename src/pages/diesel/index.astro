---
import Layout from '../../layouts/Layout.astro';
import FuelRanking from '../../components/FuelRanking.astro';
import summary from '../../data/summary.json';
import { fmtPrice } from '../../lib/stations';

const nat = summary.national_averages;
const top = summary.cheapest_diesel[0];
const title = `Diésel más barato hoy en España: ${fmtPrice(nat.diesel)} €/L de media | Ranking`;
const description = `Dónde repostar diésel más barato hoy. Media nacional ${fmtPrice(nat.diesel)} €/L y mínimo ${fmtPrice(nat.min_diesel)} €/L. Top 15 gasolineras y ranking de las 52 provincias con datos oficiales.`;

const faqs = [
  {
    question: '¿Cuál es el precio medio del diésel hoy?',
    answer: `El precio medio del diésel en España es hoy de ${fmtPrice(nat.diesel)} € por litro, según los datos oficiales del MITECO.`,
  },
  {
    question: '¿Dónde está el diésel más barato de España?',
    answer: `En ${top?.brand} de ${top?.town} (${top?.province}), a ${fmtPrice(nat.min_diesel)} €/L.`,
  },
  {
    question: '¿Qué diferencia hay entre el diésel normal y el premium?',
    answer: 'El diésel premium (Diésel+, e+ Neotech, Ultimate…) lleva aditivos detergentes que ayudan a mantener limpio el motor. Suele costar entre 8 y 15 céntimos más por litro; para la mayoría de coches el diésel A normal es suficiente.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
};
---

<Layout title={title} description={description} schema={schema} active="diesel">
  <FuelRanking fuel="diesel" faqs={faqs} />
</Layout>

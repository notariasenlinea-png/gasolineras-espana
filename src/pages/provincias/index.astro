---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import AmazonV16 from '../../components/AmazonV16.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import NightBand from '../../components/NightBand.astro';

import summary from '../../data/summary.json';
import provinces from '../../data/provinces.json';
import { fmtPrice } from '../../lib/stations';

const { national_averages: nat, updated_at, total_stations } = summary;
const [date, time] = updated_at.split(' ');
const updatedShort = `${date.slice(0, 5)} a las ${time.slice(0, 5)}`;

const provRows = provinces
  .filter((p) => p.avg_gasolina95 && p.avg_diesel)
  .map((p) => ({ name: p.name, slug: p.slug, n: p.total_stations, g95: p.avg_gasolina95 as number, d: p.avg_diesel as number }))
  .sort((a, b) => a.g95 - b.g95);
const stats = (k: 'g95' | 'd') => {
  const v = provRows.map((r) => r[k]).sort((a, b) => a - b);
  return { lo: v[0], hi: v[v.length - 1], t1: v[Math.floor(v.length / 3)], t2: v[Math.floor((2 * v.length) / 3)] };
};
const s95 = stats('g95');
const sD = stats('d');
const width = (v: number, s: ReturnType<typeof stats>) => Math.round(20 + ((v - s.lo) / (s.hi - s.lo || 1)) * 80);
const lvl = (v: number, s: ReturnType<typeof stats>) => (v < s.t1 ? 'low' : v >= s.t2 ? 'high' : 'mid');

const title = 'Precio medio de la gasolina y diésel por provincia en España';
const description = `Compara el precio medio de los carburantes en las 52 provincias españolas. Datos oficiales del MITECO actualizados cada 2 horas para más de ${total_stations.toLocaleString('es-ES')} estaciones.`;

const faqs = [
  {
    question: '¿Por qué varían tanto los precios entre provincias?',
    answer: 'La lejanía respecto a los centros de almacenamiento y refinerías (CLH/Exolum), los costes logísticos de transporte, los impuestos locales y la densidad de gasolineras low-cost influyen directamente en la media provincial.',
  },
  {
    question: '¿Cuál es la provincia más barata de España para repostar?',
    answer: 'Generalmente provincias con alta penetración de cadenas independientes como Almería, Murcia, Lleida o Navarra presentan medias de gasolina y diésel sensiblemente más bajas que la media nacional.',
  },
];
---

<Layout title={title} description={description} active="provincias">
  <NightBand>
    <div class="wrap pt-6 pb-12 sm:pb-16">
      <Breadcrumbs dark items={[{ label: 'Inicio', href: '/' }, { label: 'Provincias' }]} />
      <div class="mt-8 max-w-3xl">
        <p class="sign mb-5"><Icon name="layers" class="w-4 h-4" /> 52 provincias</p>
        <h1 class="text-white text-[2.5rem] sm:text-[4.2rem] font-black leading-[0.98] tracking-[-0.045em]">Precio medio por provincia</h1>
        <p class="text-[16.5px] sm:text-lg text-white/70 mt-5 max-w-2xl leading-relaxed">
          Comparativa en tiempo real de la más barata a la más cara. Selecciona tu provincia para consultar sus municipios y gasolineras.
        </p>
      </div>
    </div>
  </NightBand>

  <section class="wrap py-8 sm:py-12">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
      <div class="relative">
        <Icon name="search" class="w-4 h-4 text-ink-400 absolute left-3.5 top-1/2 -translate-y-1/2" />
        <input id="prov-filter" type="search" placeholder="Filtrar provincia" aria-label="Filtrar provincias" class="h-12 w-full sm:w-72 pl-10 pr-3 rounded-xl bg-white border border-ink-200 text-[14.5px] focus:outline-none focus:border-road focus:ring-4 focus:ring-road/15" />
      </div>
      <div class="seg self-start" role="group" aria-label="Combustible">
        <button type="button" class="prov-fuel" data-fuel="g95" aria-pressed="true">Gasolina 95</button>
        <button type="button" class="prov-fuel" data-fuel="d" aria-pressed="false">Diésel</button>
      </div>
    </div>

    <ol id="prov-list" class="card p-2 sm:p-3 grid md:grid-cols-2 gap-x-4">
      {provRows.map((r) => (
        <li
          class="prov-row"
          data-name={r.name.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase()}
          data-g95={r.g95}
          data-d={r.d}
          data-w-g95={width(r.g95, s95)}
          data-w-d={width(r.d, sD)}
          data-l-g95={lvl(r.g95, s95)}
          data-l-d={lvl(r.d, sD)}
        >
          <a href={`/${r.slug}/`} class="group flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-road-soft/70">
            <span class="w-32 sm:w-40 shrink-0 min-w-0">
              <span class="block text-[14.5px] font-bold truncate group-hover:text-road">{r.name}</span>
              <span class="block text-[11px] text-ink-400">{r.n} gasolineras</span>
            </span>
            <span class="flex-1 h-2.5 rounded-sm bg-ink-100 overflow-hidden">
              <span class={`prov-bar block h-full rounded-sm transition-all duration-500 dot-${lvl(r.g95, s95)}`} style={`width:${width(r.g95, s95)}%`}></span>
            </span>
            <span class="prov-price price text-[17px] w-16 text-right">{fmtPrice(r.g95)}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <div class="wrap pb-8"><AdSlot slotId="prov-list-banner" /></div>

  <section class="wrap pb-12">
    <AmazonV16 />
  </section>

  <Faq title="Preguntas frecuentes sobre precios provinciales" faqs={faqs} />
</Layout>

<script>
  const list = document.getElementById('prov-list');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('.prov-row'));
  const filter = document.getElementById('prov-filter') as HTMLInputElement | null;
  let fuel: 'g95' | 'd' = 'g95';

  function render() {
    const q = (filter?.value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
    const key = fuel === 'g95' ? 'G95' : 'D';
    rows
      .sort((a, b) => Number(a.dataset[fuel]) - Number(b.dataset[fuel]))
      .forEach((r) => {
        r.classList.toggle('hidden', !!q && !(r.dataset.name || '').includes(q));
        const bar = r.querySelector<HTMLElement>('.prov-bar');
        const price = r.querySelector<HTMLElement>('.prov-price');
        if (bar) {
          bar.style.width = `${r.dataset[`w${key}`]}%`;
          bar.classList.remove('dot-low', 'dot-mid', 'dot-high');
          bar.classList.add(`dot-${r.dataset[`l${key}`]}`);
        }
        if (price) price.textContent = Number(r.dataset[fuel]).toFixed(3).replace('.', ',');
        list?.appendChild(r);
      });
  }

  document.querySelectorAll<HTMLButtonElement>('.prov-fuel').forEach((b) =>
    b.addEventListener('click', () => {
      fuel = b.dataset.fuel === 'd' ? 'd' : 'g95';
      document.querySelectorAll('.prov-fuel').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      render();
    }),
  );
  filter?.addEventListener('input', render);
</script>

---
import Layout from '../layouts/Layout.astro';
import Finder from '../components/Finder.astro';
import PriceTotem from '../components/PriceTotem.astro';
import Leaderboard from '../components/Leaderboard.astro';
import PriceMap from '../components/PriceMap.astro';
import SavingsCalculator from '../components/SavingsCalculator.astro';
import AdSlot from '../components/AdSlot.astro';
import AmazonV16 from '../components/AmazonV16.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';

import summary from '../data/summary.json';
import { fmtEuros, fmtPrice, type GasStation } from '../lib/stations';

const { national_averages: nat, cheapest_gasolina95, cheapest_diesel, updated_at, total_stations } = summary;
const top95 = cheapest_gasolina95 as GasStation[];
const topD = cheapest_diesel as GasStation[];
const [date, time] = updated_at.split(' ');
const updatedShort = `${date.slice(0, 5)} a las ${time.slice(0, 5)}`;
const tankSaving = (nat.gasolina95 - nat.min_gasolina95) * 50;

const title = 'Gasolineras más baratas hoy en España | Precio gasolina y diésel en directo';
const description = `Encuentra la gasolinera más barata cerca de ti. Precios oficiales de gasolina 95 (media ${fmtPrice(nat.gasolina95)} €/L) y diésel (${fmtPrice(nat.diesel)} €/L) en ${total_stations.toLocaleString('es-ES')} gasolineras de España, actualizados cada 2 horas.`;

const faqs = [
  {
    question: '¿De dónde salen los precios?',
    answer: 'Del Ministerio para la Transición Ecológica (MITECO). Por ley (Orden ITC/2308/2007) todas las gasolineras de España deben comunicar sus precios cada vez que los cambian. Descargamos los datos oficiales cada 2 horas.',
  },
  {
    question: '¿Cómo encuentro la gasolinera más barata cerca de mí?',
    answer: 'Pulsa «Gasolineras cerca de mí» y permite la ubicación. Te mostramos al instante las 5 más cercanas y, con un toque, las más baratas a menos de 10 km. También puedes abrir el mapa y ver todas las gasolineras coloreadas de verde (barata) a rojo (cara).',
  },
  {
    question: '¿Por qué hay tanta diferencia de precio entre gasolineras?',
    answer: 'El mercado está liberalizado. Las estaciones automáticas o low-cost (Plenergy, Ballenoil, Petroprix…) tienen menos costes que las tradicionales con tienda y personal, y la ubicación también influye: autopistas y zonas turísticas suelen ser más caras.',
  },
  {
    question: '¿Cuánto puedo ahorrar de verdad?',
    answer: `Hoy la diferencia entre la gasolina 95 media (${fmtPrice(nat.gasolina95)} €/L) y la más barata de España (${fmtPrice(nat.min_gasolina95)} €/L) supone ${fmtEuros(tankSaving)} en un depósito de 50 litros. Dentro de una misma ciudad la diferencia suele ser de 5 a 15 € por depósito.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
};
---

<Layout title={title} description={description} schema={faqSchema} active="home">
  <!-- HERO -->
  <section class="relative bg-ink text-white">
    <div class="absolute inset-0 texture pointer-events-none"></div>
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 -right-40 w-[36rem] h-[36rem] rounded-full bg-volt/10 blur-3xl"></div>
    </div>
    <div class="wrap relative grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-10 lg:gap-14 items-center py-10 sm:py-16 lg:py-20">
      <div class="min-w-0">
        <p class="inline-flex items-center gap-2 text-[12px] font-medium text-white/60 mb-5">
          <span class="live-dot"></span> Precios oficiales · actualizado el {updatedShort}
        </p>
        <h1 class="text-white text-[2.6rem] leading-[1.02] sm:text-6xl lg:text-[4.2rem] font-extrabold tracking-[-0.035em]">
          Reposta más barato.<br />
          <span class="text-volt">Hoy, cerca de ti.</span>
        </h1>
        <p class="mt-5 mb-8 text-[16px] sm:text-lg text-white/60 max-w-xl">
          Compara al momento el precio de la gasolina y el diésel en las {total_stations.toLocaleString('es-ES')} gasolineras de España.
        </p>
        <Finder />
      </div>

      <div class="hidden sm:block">
        <PriceTotem
          title="Precio medio en España"
          subtitle={`${total_stations.toLocaleString('es-ES')} gasolineras · datos MITECO`}
          rows={[
            { label: 'Gasolina 95', price: nat.gasolina95, dot: '#16A34A', note: `La más barata: ${fmtPrice(nat.min_gasolina95)} €` },
            { label: 'Diésel', price: nat.diesel, dot: '#E5E7EB', note: `La más barata: ${fmtPrice(nat.min_diesel)} €` },
          ]}
          footer={`Eligiendo bien ahorras hasta ${fmtEuros(tankSaving)} por depósito.`}
        />
      </div>
    </div>
  </section>

  <!-- Mobile KPIs -->
  <div class="sm:hidden wrap pt-5">
    <div class="grid grid-cols-2 gap-2.5">
      <div class="card p-4"><p class="text-[12px] text-ink-500">Media gasolina 95</p><p class="price text-2xl">{fmtPrice(nat.gasolina95)} <span class="text-sm text-ink-400">€</span></p></div>
      <div class="card p-4"><p class="text-[12px] text-ink-500">Media diésel</p><p class="price text-2xl">{fmtPrice(nat.diesel)} <span class="text-sm text-ink-400">€</span></p></div>
    </div>
  </div>

  <!-- CHEAPEST TODAY -->
  <section class="wrap pt-12 sm:pt-20" aria-labelledby="top-title">
    <p class="eyebrow mb-2"><Icon name="trophy" class="w-4 h-4" /> Ranking nacional</p>
    <h2 id="top-title" class="text-3xl sm:text-4xl font-bold mb-6">Las más baratas de España hoy</h2>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 sm:gap-5">
      <Leaderboard id="top5-g95" title="Gasolina 95" fuel="gasolina95" stations={top95.slice(0, 5)} avg={nat.gasolina95} moreHref="/gasolina-95/" moreLabel="Top 15" />
      <Leaderboard id="top5-diesel" title="Diésel" fuel="diesel" stations={topD.slice(0, 5)} avg={nat.diesel} moreHref="/diesel/" moreLabel="Top 15" />
    </div>
  </section>

  <!-- MAP -->
  <section class="wrap pt-14 sm:pt-20" aria-labelledby="map-title">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <p class="eyebrow mb-2"><Icon name="map" class="w-4 h-4" /> Mapa en directo</p>
        <h2 id="map-title" class="text-3xl sm:text-4xl font-bold">Todas las gasolineras, de un vistazo</h2>
        <p class="text-[15px] text-ink-500 mt-2 max-w-xl">Verde es barata, rojo es cara. Acerca el mapa para ver el precio de cada una.</p>
      </div>
      <a href="/mapa/" class="btn-ink shrink-0 self-start sm:self-auto">Abrir mapa completo <Icon name="arrow-right" class="w-4 h-4" /></a>
    </div>
    <div class="card overflow-hidden">
      <PriceMap id="home-map" source="all" class="h-[420px] sm:h-[520px]" />
    </div>
  </section>

  <div class="wrap pt-12"><AdSlot slotId="home-top-banner" /></div>

  <!-- CALCULATOR -->
  <section class="wrap pt-14 sm:pt-20">
    <SavingsCalculator avgGasolina95={nat.gasolina95} minGasolina95={nat.min_gasolina95} avgDiesel={nat.diesel} minDiesel={nat.min_diesel} />
  </section>

  <section class="wrap pt-6">
    <AmazonV16 />
  </section>

  <Faq title="Todo lo que necesitas saber para ahorrar" faqs={faqs} />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import GasolineraCard from '../components/GasolineraCard.astro';
import GpsNearby from '../components/GpsNearby.astro';
import SavingsCalculator from '../components/SavingsCalculator.astro';
import AdSlot from '../components/AdSlot.astro';

import summary from '../data/summary.json';
import provinces from '../data/provinces.json';

const { national_averages, cheapest_gasolina95, cheapest_diesel, updated_at, total_stations } = summary;

const title = 'Precio Gasolina y Diésel Hoy en España | Gasolineras Más Baratas en Directo';
const description = `Consulta en directo el precio de la gasolina 95 (${national_averages.gasolina95} €/L) y diésel (${national_averages.diesel} €/L) en más de ${total_stations.toLocaleString('es-ES')} gasolineras de España. Ahorra hasta 30 céntimos por litro con datos oficiales MITECO.`;

const faqs = [
  {
    question: '¿De dónde provienen los precios de las gasolineras?',
    answer: 'Todos los precios son extraídos directamente en tiempo real de la base de datos oficial del Ministerio para la Transición Ecológica y el Reto Demográfico (MITECO). Por ley (Orden ITC/2308/2007), todas las estaciones de servicio de España están obligadas a comunicar sus precios vigentes al ministerio cada vez que aplican una modificación.'
  },
  {
    question: '¿Con qué frecuencia se actualizan los datos?',
    answer: 'La sincronización con los servidores oficiales del ministerio se realiza de forma continua varias veces al día. En esta página siempre verás la última fecha y hora exacta de actualización oficial.'
  },
  {
    question: '¿Cómo puedo encontrar las gasolineras más baratas cerca de mí?',
    answer: 'Utiliza nuestro botón "Activar GPS y Buscar Cerca" situado en la sección superior. El sistema solicitará permiso a tu dispositivo y calculará en menos de 1 segundo mediante la fórmula de Haversine la distancia exacta a todas las estaciones cercanas, mostrándote en primer lugar las más baratas.'
  },
  {
    question: '¿Por qué hay tanta diferencia de precio entre gasolineras?',
    answer: 'El mercado de hidrocarburos en España está completamente liberalizado. Factores como el modelo de negocio (estaciones automáticas o low cost como Plenoil, Petroprix o Ballenoil frente a estaciones tradicionales con tienda y personal), los costes logísticos según la proximidad a los centros de almacenamiento de Exolum (antigua CLH), y los márgenes comerciales explican variaciones de más de 30 céntimos por litro.'
  },
  {
    question: '¿Qué combustible compensa más para el ahorro diario?',
    answer: `Hoy en España el precio medio de la Gasolina 95 se sitúa en ${national_averages.gasolina95.toFixed(3)} €/L, mientras que el Diésel (Gasóleo A) marca una media de ${national_averages.diesel.toFixed(3)} €/L. En las estaciones más económicas del ranking nacional puedes repostar Gasolina 95 desde ${national_averages.min_gasolina95.toFixed(3)} €/L y Diésel desde ${national_averages.min_diesel.toFixed(3)} €/L.`
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map((f) => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<Layout title={title} description={description} schema={faqSchema} activeFuel="home">
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-emerald-950/10 via-slate-50 to-slate-50 pt-10 pb-8 sm:pt-16 sm:pb-14 border-b border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-100 text-emerald-900 text-xs font-black uppercase tracking-wider mb-4 border border-emerald-300 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
          Precios Oficiales de Hoy: {updated_at}
        </div>
        
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-950 tracking-tight leading-tight sm:leading-none mb-4">
          Precios de Gasolina y Diésel <br class="hidden sm:inline" />
          <span class="text-emerald-700">Hoy en España</span>
        </h1>
        
        <p class="text-base sm:text-lg text-slate-700 mb-8 leading-relaxed max-w-2xl mx-auto">
          Monitorizamos en directo <strong>{total_stations.toLocaleString('es-ES')} gasolineras</strong> en toda España. Compara precios al instante y ahorra hasta <strong>{((national_averages.gasolina95 - national_averages.min_gasolina95) * 50).toFixed(1)}€</strong> por cada depósito.
        </p>

        <!-- Bento-Style National Averages KPI Cards -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 max-w-4xl mx-auto">
          <!-- Gasolina 95 Media -->
          <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/90 shadow-soft-card hover:border-emerald-500 hover:-translate-y-0.5 transition-all text-left">
            <div class="flex items-center justify-between text-xs text-slate-600 font-bold mb-1">
              <span>Media Gasolina 95</span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
            </div>
            <div class="flex items-baseline gap-1 my-1.5">
              <span class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight tabular-nums">
                {national_averages.gasolina95.toFixed(3)}
              </span>
              <span class="text-xs font-bold text-slate-500">€/L</span>
            </div>
            <p class="text-xs text-emerald-800 font-bold">Mínimo: {national_averages.min_gasolina95.toFixed(3)} €</p>
          </div>

          <!-- Diésel Media -->
          <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/90 shadow-soft-card hover:border-sky-500 hover:-translate-y-0.5 transition-all text-left">
            <div class="flex items-center justify-between text-xs text-slate-600 font-bold mb-1">
              <span>Media Diésel A</span>
              <span class="w-2.5 h-2.5 rounded-full bg-sky-600"></span>
            </div>
            <div class="flex items-baseline gap-1 my-1.5">
              <span class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight tabular-nums">
                {national_averages.diesel.toFixed(3)}
              </span>
              <span class="text-xs font-bold text-slate-500">€/L</span>
            </div>
            <p class="text-xs text-sky-800 font-bold">Mínimo: {national_averages.min_diesel.toFixed(3)} €</p>
          </div>

          <!-- Estaciones Monitorizadas -->
          <div class="bg-white rounded-2xl p-4 sm:p-5 border border-slate-200/90 shadow-soft-card text-left">
            <div class="flex items-center justify-between text-xs text-slate-600 font-bold mb-1">
              <span>Gasolineras Activas</span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
            </div>
            <div class="flex items-baseline gap-1 my-1.5">
              <span class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight tabular-nums">
                {total_stations.toLocaleString('es-ES')}
              </span>
            </div>
            <p class="text-xs text-slate-600 font-semibold">50 prov. + Ceuta/Melilla</p>
          </div>

          <!-- Ahorro Potencial Máximo -->
          <div class="bg-gradient-to-br from-emerald-700 via-emerald-800 to-teal-900 rounded-2xl p-4 sm:p-5 text-white shadow-md shadow-emerald-900/20 text-left">
            <div class="text-xs font-black text-emerald-200 uppercase tracking-wider mb-1">
              Ahorro / Depósito
            </div>
            <div class="flex items-baseline gap-1 my-1.5">
              <span class="text-2xl sm:text-3xl font-black tracking-tight text-white tabular-nums">
                {((national_averages.gasolina95 - national_averages.min_gasolina95) * 50).toFixed(2)}
              </span>
              <span class="text-xs font-bold text-emerald-200">€ (50L)</span>
            </div>
            <p class="text-xs text-emerald-100 font-medium">Eligiendo la más barata</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GPS Nearby Section Component -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <GpsNearby />
  </div>

  <!-- Ad Slot Top -->
  <AdSlot format="horizontal" slotId="home-top-banner" />

  <!-- Top 10 National Cheapest Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14" aria-labelledby="top-cheapest-title">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-1.5 text-xs font-black uppercase tracking-wider text-emerald-800 mb-1">
          <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          Precios Mínimos Verificados
        </div>
        <h2 id="top-cheapest-title" class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight">
          Top 10 Gasolineras Más Baratas de España Hoy
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-1">
          Compara las estaciones con los precios más bajos del territorio nacional según el MITECO.
        </p>
      </div>

      <!-- Fuel Switch Tabs with accessible ARIA -->
      <div class="inline-flex p-1 bg-slate-200/90 rounded-2xl" role="tablist" aria-label="Selección de combustible para ranking">
        <button
          id="tab-btn-g95"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="tab-content-g95"
          class="px-4 py-2 text-xs font-black rounded-xl transition-all bg-white text-slate-950 shadow-2xs cursor-pointer focus-visible:ring-2 focus-visible:ring-emerald-600"
        >
          Gasolina 95
        </button>
        <button
          id="tab-btn-diesel"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="tab-content-diesel"
          class="px-4 py-2 text-xs font-bold rounded-xl transition-all text-slate-700 hover:text-slate-950 cursor-pointer focus-visible:ring-2 focus-visible:ring-sky-600"
        >
          Diésel / Gasóleo A
        </button>
      </div>
    </div>

    <!-- Gasolina 95 Grid -->
    <div id="tab-content-g95" role="tabpanel" aria-labelledby="tab-btn-g95" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {cheapest_gasolina95.slice(0, 9).map((st, i) => (
        <GasolineraCard
          station={st}
          rank={i + 1}
          avgGasolina95={national_averages.gasolina95}
          avgDiesel={national_averages.diesel}
          highlightFuel="gasolina95"
        />
      ))}
    </div>

    <!-- Diésel Grid (hidden by default) -->
    <div id="tab-content-diesel" role="tabpanel" aria-labelledby="tab-btn-diesel" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {cheapest_diesel.slice(0, 9).map((st, i) => (
        <GasolineraCard
          station={st}
          rank={i + 1}
          avgGasolina95={national_averages.gasolina95}
          avgDiesel={national_averages.diesel}
          highlightFuel="diesel"
        />
      ))}
    </div>
  </section>

  <!-- Interactive Savings Calculator -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SavingsCalculator
      avgGasolina95={national_averages.gasolina95}
      minGasolina95={national_averages.min_gasolina95}
      avgDiesel={national_averages.diesel}
      minDiesel={national_averages.min_diesel}
    />
  </div>

  <!-- Province Selector Grid (All 52 provinces) -->
  <section id="provincias" class="scroll-mt-24 bg-white border-y border-slate-200/90 py-12 sm:py-16" aria-labelledby="provinces-title">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 id="provinces-title" class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight mb-2">
          Precios por Provincia en España
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          Selecciona tu provincia para consultar los precios actualizados y las estaciones más baratas en cada municipio.
        </p>

        <!-- Quick filter search bar -->
        <div class="mt-5 max-w-md mx-auto relative">
          <input
            id="province-search"
            type="text"
            placeholder="Escribe tu provincia (ej. Madrid, Valencia, Sevilla...)"
            aria-label="Filtrar por nombre de provincia"
            class="w-full px-4 py-3 rounded-2xl border border-slate-300 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 shadow-2xs pl-10 pr-10"
          />
          <svg class="w-5 h-5 text-slate-400 absolute left-3 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span id="province-count-badge" class="absolute right-3 top-3.5 text-[11px] font-bold text-slate-400">
            {provinces.length} prov.
          </span>
        </div>
      </div>

      <!-- Grid of all 52 Provinces -->
      <div id="provinces-list" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
        {provinces.map((p) => (
          <a
            href={`/${p.slug}/`}
            data-province-name={p.name.toLowerCase()}
            class="province-item p-3.5 rounded-2xl border border-slate-200/90 hover:border-emerald-500 hover:bg-emerald-50/40 hover:-translate-y-0.5 transition-all flex flex-col justify-between group shadow-2xs"
          >
            <div>
              <span class="text-[11px] text-slate-500 block font-semibold truncate">{p.ccaa}</span>
              <h3 class="font-extrabold text-sm text-slate-900 group-hover:text-emerald-800 transition-colors truncate">
                {p.name}
              </h3>
            </div>
            <div class="mt-3 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]">
              <span class="text-slate-600 font-medium">{p.total_stations} gasol.</span>
              <span class="font-black text-emerald-800 tabular-nums">{p.min_gasolina95 ? `${p.min_gasolina95.toFixed(2)}€` : 'Ver'}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Ad Slot In-Between -->
  <AdSlot format="horizontal" slotId="home-mid-banner" />

  <!-- FAQ Section with Schema -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16" aria-labelledby="faq-title">
    <div class="text-center mb-10">
      <h2 id="faq-title" class="text-2xl sm:text-3xl font-black text-slate-950 tracking-tight mb-2">
        Preguntas Frecuentes sobre el Precio de los Carburantes
      </h2>
      <p class="text-xs sm:text-sm text-slate-600">
        Resolvemos tus dudas sobre cómo ahorrar repostando y la procedencia de los datos oficiales.
      </p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <details class="group bg-white rounded-2xl border border-slate-200/90 p-5 open:shadow-soft-card transition-all">
          <summary class="flex items-center justify-between cursor-pointer list-none font-bold text-slate-900 group-open:text-emerald-800 text-sm sm:text-base select-none focus:outline-none">
            <span>{faq.question}</span>
            <span class="ml-4 shrink-0 transition-transform duration-200 group-open:rotate-180 text-slate-500">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-3 text-xs sm:text-sm text-slate-700 leading-relaxed pt-3 border-t border-slate-100">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </section>
</Layout>

<script>
  // Top 10 Fuel Tabs Switcher with ARIA support
  const btnG95 = document.getElementById('tab-btn-g95');
  const btnDiesel = document.getElementById('tab-btn-diesel');
  const contentG95 = document.getElementById('tab-content-g95');
  const contentDiesel = document.getElementById('tab-content-diesel');

  if (btnG95 && btnDiesel && contentG95 && contentDiesel) {
    btnG95.addEventListener('click', () => {
      btnG95.className = 'px-4 py-2 text-xs font-black rounded-xl transition-all bg-white text-slate-950 shadow-2xs cursor-pointer focus-visible:ring-2 focus-visible:ring-emerald-600';
      btnG95.setAttribute('aria-selected', 'true');
      btnDiesel.className = 'px-4 py-2 text-xs font-bold rounded-xl transition-all text-slate-700 hover:text-slate-950 cursor-pointer focus-visible:ring-2 focus-visible:ring-sky-600';
      btnDiesel.setAttribute('aria-selected', 'false');
      contentG95.classList.remove('hidden');
      contentDiesel.classList.add('hidden');
    });

    btnDiesel.addEventListener('click', () => {
      btnDiesel.className = 'px-4 py-2 text-xs font-black rounded-xl transition-all bg-white text-slate-950 shadow-2xs cursor-pointer focus-visible:ring-2 focus-visible:ring-sky-600';
      btnDiesel.setAttribute('aria-selected', 'true');
      btnG95.className = 'px-4 py-2 text-xs font-bold rounded-xl transition-all text-slate-700 hover:text-slate-950 cursor-pointer focus-visible:ring-2 focus-visible:ring-emerald-600';
      btnG95.setAttribute('aria-selected', 'false');
      contentDiesel.classList.remove('hidden');
      contentG95.classList.add('hidden');
    });
  }

  // Live filter for 52 provinces
  const searchInput = document.getElementById('province-search') as HTMLInputElement | null;
  const countBadge = document.getElementById('province-count-badge');
  const provinceItems = document.querySelectorAll<HTMLElement>('.province-item');

  if (searchInput && provinceItems.length > 0) {
    searchInput.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
      let visibleCount = 0;
      provinceItems.forEach((item) => {
        const pName = item.getAttribute('data-province-name') || '';
        if (pName.includes(q)) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });
      if (countBadge) {
        countBadge.textContent = `${visibleCount} prov.`;
      }
    });
  }
</script>

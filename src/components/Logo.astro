---
// Logotipo: la señal de «estación de servicio» de las carreteras españolas
// (cartel azul con recuadro blanco y surtidor) + marca en Overpass.
interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props;
---

<span class="inline-flex items-center gap-2.5">
  <svg viewBox="0 0 40 40" class="w-9 h-9 shrink-0" aria-hidden="true">
    <rect x="1" y="1" width="38" height="38" rx="8" fill="#1B4FA8" />
    <rect x="3.5" y="3.5" width="33" height="33" rx="6" fill="none" stroke="#fff" stroke-width="1.6" />
    <rect x="8" y="8" width="24" height="24" rx="2.5" fill="#fff" />
    <path d="M13 29V13.2c0-.9.7-1.6 1.6-1.6h6.2c.9 0 1.6.7 1.6 1.6V29z" fill="#14181F" />
    <rect x="14.8" y="13.6" width="5.8" height="4.6" rx=".8" fill="#FFC21A" />
    <path d="M22.4 17.5h1.8c.8 0 1.4.6 1.4 1.4v5.6c0 .7.5 1.2 1.2 1.2s1.2-.5 1.2-1.2v-7.4l-2.4-2.6" fill="none" stroke="#14181F" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    <rect x="11.5" y="28.4" width="12.4" height="1.8" rx=".6" fill="#14181F" />
  </svg>
  <span class={`font-display text-[18px] font-extrabold tracking-[-0.03em] leading-none ${dark ? 'text-white' : 'text-ink'}`}>
    gasolineras<span class={dark ? 'text-volt' : 'text-road'}>enlínea</span>
  </span>
</span>

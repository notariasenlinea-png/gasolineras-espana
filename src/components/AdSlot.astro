---
interface Props {
  slotId?: string;
  format?: 'horizontal' | 'rectangle' | 'in-feed';
  class?: string;
}

const { slotId = 'default-slot', format = 'horizontal', class: className = '' } = Astro.props;

const formatClasses = {
  horizontal: 'min-h-[100px] sm:min-h-[110px]',
  rectangle: 'min-h-[250px]',
  'in-feed': 'min-h-[110px]',
};
---

<aside class={`ad-container ${className}`} aria-label="Publicidad">
  <div class={`relative rounded-2xl bg-ink-50/70 border border-dashed border-ink-200 flex flex-col items-center justify-center overflow-hidden ${formatClasses[format]}`}>
    <span class="absolute top-2 left-3 text-[10px] font-medium uppercase tracking-[0.14em] text-ink-300">Publicidad</span>
    <ins
      class="adsbygoogle"
      style="display:block;width:100%;text-align:center;"
      data-ad-client={import.meta.env.PUBLIC_ADSENSE_CLIENT || 'ca-pub-3058147259550236'}
      data-ad-slot={slotId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
  </div>
</aside>

---
// Ranked list of the cheapest stations for one fuel.
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import { fmtPrice, stationUrl, type GasStation } from '../lib/stations';

interface Props {
  title: string;
  fuel: 'gasolina95' | 'diesel';
  stations: GasStation[];
  avg?: number | null;
  moreHref?: string;
  moreLabel?: string;
  id?: string;
  where?: 'province' | 'town';
}

const { title, fuel, stations, avg, moreHref, moreLabel = 'Ver ranking', id, where = 'province' } = Astro.props;
const color = fuel === 'gasolina95' ? '#16A34A' : '#111827';
---

<section id={id} class="card overflow-hidden">
  <header class="flex items-center justify-between gap-3 px-5 sm:px-6 pt-5 pb-4">
    <h3 class="flex items-center gap-2.5 text-lg font-bold">
      <span class="w-1.5 h-6 rounded-full" style={`background:${color}`}></span>
      {title}
    </h3>
    {moreHref && (
      <a href={moreHref} class="text-[13px] font-semibold text-ink-500 hover:text-ink inline-flex items-center gap-1">
        {moreLabel}<Icon name="arrow-right" class="w-3.5 h-3.5" />
      </a>
    )}
  </header>
  <ol class="border-t border-ink-100 divide-y divide-ink-100">
    {stations.map((st, i) => {
      const p = st.prices?.[fuel] ?? null;
      const diff = p !== null && typeof avg === 'number' ? (avg - p) * 50 : null;
      return (
        <li>
          <a href={stationUrl(st)} class="group flex items-center gap-3 sm:gap-4 px-5 sm:px-6 py-3.5 hover:bg-ink-50/70 transition-colors">
            <span class={`w-6 text-center font-display text-lg font-bold tabular-nums ${i === 0 ? 'text-ink' : 'text-ink-300'}`}>{i + 1}</span>
            <BrandMark brand={st.brand} size="sm" />
            <span class="min-w-0 flex-1">
              <span class="block text-[15px] font-semibold truncate">{st.brand} <span class="font-normal text-ink-500">· {st.town}</span></span>
              <span class="block text-[12px] text-ink-400 truncate">{st.address}{where === 'province' ? `, ${st.province}` : ''}</span>
            </span>
            <span class="text-right shrink-0">
              <span class="price block text-xl leading-none">{fmtPrice(p)}</span>
              {diff !== null && diff > 0.5 && (
                <span class="block text-[11px] font-semibold text-cheap-ink mt-1 tabular-nums">−{diff.toFixed(2).replace('.', ',')} € / 50 L</span>
              )}
            </span>
          </a>
        </li>
      );
    })}
  </ol>
</section>

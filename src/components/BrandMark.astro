---
import { brandStyle } from '../lib/stations';

interface Props {
  brand: string;
  size?: 'sm' | 'md' | 'lg';
}

const { brand, size = 'md' } = Astro.props;
const { bg, fg, initials } = brandStyle(brand);
const sizes = {
  sm: 'w-9 h-9 text-[11px] rounded-lg',
  md: 'w-11 h-11 text-xs rounded-[10px]',
  lg: 'w-16 h-16 text-lg rounded-2xl',
};
---

<span
  class={`shrink-0 inline-flex items-center justify-center font-display font-extrabold tracking-tight ring-1 ring-black/10 ${sizes[size]}`}
  style={`background:${bg};color:${fg}`}
  aria-hidden="true"
>
  {initials}
</span>

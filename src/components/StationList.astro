---
// Sortable, filterable and paginated station list. Every card is in the HTML
// (crawlable); the client script only reorders and hides them.
import StationCard from './StationCard.astro';
import type { GasStation } from '../lib/stations';

interface Props {
  id: string;
  stations: GasStation[];
  avgG95?: number | null;
  avgDiesel?: number | null;
  perPage?: number;
  showTown?: boolean;
}

const { id, stations, avgG95, avgDiesel, perPage = 12, showTown = false } = Astro.props;

const sorted = [...stations].sort(
  (a, b) => (a.prices?.gasolina95 ?? 99) - (b.prices?.gasolina95 ?? 99) || (a.prices?.diesel ?? 99) - (b.prices?.diesel ?? 99),
);
const has24h = stations.some((s) => s.is_24h);
const hasLowCost = sorted.length > 1;
---

<div class="station-list group/list" id={id} data-per-page={perPage} data-fuel="g95">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
    <div class="seg self-start" role="group" aria-label="Ordenar por precio de">
      <button type="button" data-sort="g95" aria-pressed="true" class="sl-sort">Gasolina 95</button>
      <button type="button" data-sort="diesel" aria-pressed="false" class="sl-sort">Diésel</button>
    </div>
    <div class="flex gap-2 overflow-x-auto no-scrollbar" role="group" aria-label="Filtrar">
      <button type="button" data-filter="all" aria-pressed="true" class="sl-filter chip">Todas <span class="text-[11px] opacity-60">{stations.length}</span></button>
      {has24h && <button type="button" data-filter="24h" aria-pressed="false" class="sl-filter chip">Abiertas 24h</button>}
      {hasLowCost && <button type="button" data-filter="lowcost" aria-pressed="false" class="sl-filter chip">Low-cost</button>}
    </div>
  </div>

  <div class="sl-grid grid grid-cols-1 gap-2">
    {sorted.map((st, i) => (
      <StationCard station={st} avgG95={avgG95} avgDiesel={avgDiesel} showTown={showTown} />
    ))}
  </div>

  <p class="sl-empty hidden py-12 text-center text-sm text-ink-500">Ninguna gasolinera cumple este filtro.</p>

  <nav class="sl-pager hidden mt-5 flex items-center justify-between gap-3" aria-label="Paginación">
    <button type="button" class="sl-prev btn-ghost h-10 text-[13px]">← Anteriores</button>
    <span class="sl-info text-[13px] font-medium text-ink-500 tabular-nums"></span>
    <button type="button" class="sl-next btn-ghost h-10 text-[13px]">Siguientes →</button>
  </nav>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.station-list').forEach((root) => {
    const grid = root.querySelector<HTMLElement>('.sl-grid')!;
    const pager = root.querySelector<HTMLElement>('.sl-pager')!;
    const info = root.querySelector<HTMLElement>('.sl-info')!;
    const prev = root.querySelector<HTMLButtonElement>('.sl-prev')!;
    const next = root.querySelector<HTMLButtonElement>('.sl-next')!;
    const empty = root.querySelector<HTMLElement>('.sl-empty')!;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.station-card'));
    const perPage = Number(root.dataset.perPage) || 12;

    let sortKey: 'g95' | 'diesel' = 'g95';
    let filter = 'all';
    let page = 0;

    const priceOf = (el: HTMLElement) => {
      const v = sortKey === 'g95' ? el.dataset.p95 : el.dataset.diesel;
      return v ? Number(v) : 99;
    };

    function render(scroll = false) {
      const visible = cards
        .filter((c) => filter === 'all' || (filter === '24h' ? c.dataset['24h'] === '1' : c.dataset.lowcost === '1'))
        .sort((a, b) => priceOf(a) - priceOf(b));
      const pages = Math.max(1, Math.ceil(visible.length / perPage));
      page = Math.min(page, pages - 1);

      cards.forEach((c) => c.classList.add('hidden'));
      visible.forEach((c, i) => {
        grid.appendChild(c);
        c.classList.toggle('hidden', Math.floor(i / perPage) !== page);
      });

      empty.classList.toggle('hidden', visible.length > 0);
      pager.classList.toggle('hidden', pages <= 1);
      info.textContent = `${page * perPage + 1}–${Math.min(visible.length, (page + 1) * perPage)} de ${visible.length}`;
      prev.disabled = page === 0;
      next.disabled = page >= pages - 1;
      if (scroll) root.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    root.querySelectorAll<HTMLButtonElement>('.sl-sort').forEach((btn) =>
      btn.addEventListener('click', () => {
        sortKey = btn.dataset.sort === 'diesel' ? 'diesel' : 'g95';
        root.dataset.fuel = sortKey;
        root.querySelectorAll('.sl-sort').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        page = 0;
        render();
      }),
    );
    root.querySelectorAll<HTMLButtonElement>('.sl-filter').forEach((btn) =>
      btn.addEventListener('click', () => {
        filter = btn.dataset.filter || 'all';
        root.querySelectorAll('.sl-filter').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        page = 0;
        render();
      }),
    );
    prev.addEventListener('click', () => { page--; render(true); });
    next.addEventListener('click', () => { page++; render(true); });

    render();
  });
</script>

---
import Icon from './Icon.astro';

interface Props {
  active?: string;
}
const { active = '' } = Astro.props;

const items = [
  { id: 'home', label: 'Inicio', href: '/', icon: 'home' },
  { id: 'cerca', label: 'Cerca', href: '/?cerca=1#buscar', icon: 'locate' },
  { id: 'mapa', label: 'Mapa', href: '/mapa/', icon: 'map' },
  { id: 'gasolina-95', label: 'Ranking', href: '/gasolina-95/', icon: 'trophy' },
] as const;
---

<nav
  class="md:hidden fixed bottom-0 inset-x-0 z-[1000] bg-ink text-white border-t border-white/10 pb-[env(safe-area-inset-bottom)]"
  aria-label="Navegación rápida"
>
  <ul class="grid grid-cols-4">
    {items.map((it) => (
      <li>
        <a
          href={it.href}
          data-nav={it.id}
          class={`flex flex-col items-center gap-1 pt-2 pb-2 font-display text-[11px] font-bold ${active === it.id ? 'text-white' : 'text-white/55'}`}
          aria-current={active === it.id ? 'page' : undefined}
        >
          <span class={`w-12 h-7 rounded-lg flex items-center justify-center ${active === it.id ? 'bg-volt text-ink' : ''}`}>
            <Icon name={it.icon} class="w-5 h-5" />
          </span>
          {it.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-nav="cerca"]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const finder = document.getElementById('buscar');
      const gpsBtn = document.getElementById('btn-gps-locate');
      if (finder && gpsBtn) {
        e.preventDefault();
        finder.scrollIntoView({ behavior: 'smooth', block: 'start' });
        gpsBtn.click();
      }
    });
  });
</script>

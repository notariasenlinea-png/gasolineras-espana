---
import { brandBadgeClass, fmtPrice, isLowCost, stationUrl, type GasStation } from '../lib/stations';

interface Props {
  station: GasStation;
  rank?: number;
  avgGasolina95?: number | null;
  avgDiesel?: number | null;
  highlightFuel?: 'gasolina95' | 'diesel';
  class?: string;
}

const {
  station,
  rank,
  avgGasolina95,
  avgDiesel,
  highlightFuel = 'gasolina95',
  class: className = '',
} = Astro.props;

const p95 = station.prices?.gasolina95 ?? null;
const pDiesel = station.prices?.diesel ?? null;
const diff95 = p95 !== null && avgGasolina95 ? p95 - avgGasolina95 : null;
const diffDiesel = pDiesel !== null && avgDiesel ? pDiesel - avgDiesel : null;
const lowCost = isLowCost(station.brand);
const href = stationUrl(station);

const fuels = [
  { key: 'gasolina95', label: 'Gasolina 95', price: p95, diff: diff95 },
  { key: 'diesel', label: 'Diésel A', price: pDiesel, diff: diffDiesel },
] as const;
---

<a
  href={href}
  class={`station-card group flex flex-col bg-white rounded-2xl border border-slate-200 shadow-sm hover:border-emerald-500 hover:shadow-md transition-all duration-150 p-4 focus-visible:ring-2 focus-visible:ring-emerald-600 ${className}`}
  data-station-id={station.id}
  data-p95={p95 ?? ''}
  data-diesel={pDiesel ?? ''}
  data-24h={station.is_24h ? '1' : '0'}
  data-lowcost={lowCost ? '1' : '0'}
  aria-label={`Ver precios y ficha de ${station.brand} en ${station.address}, ${station.town}`}
>
  <div class="flex items-center gap-2 flex-wrap mb-2">
    {rank !== undefined && (
      <span class={`inline-flex items-center justify-center min-w-[1.75rem] h-6 px-1.5 rounded-md text-[11px] font-black tabular-nums ${rank === 1 ? 'bg-amber-400 text-amber-950' : 'bg-slate-100 text-slate-700'}`}>
        {rank}º
      </span>
    )}
    <span class={`inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-bold border uppercase tracking-wide ${brandBadgeClass(station.brand)}`}>
      {station.brand}
    </span>
    {station.is_24h && (
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>24H
      </span>
    )}
    {lowCost && (
      <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-sky-50 text-sky-800 border border-sky-200">Low-cost</span>
    )}
  </div>

  <h3 class="text-sm font-extrabold text-slate-900 group-hover:text-emerald-800 transition-colors line-clamp-1">
    {station.address}
  </h3>
  <p class="text-xs text-slate-500 mt-0.5 line-clamp-1">
    {station.town}{station.postal_code ? ` · ${station.postal_code}` : ''} · {station.province}
  </p>

  <div class="grid grid-cols-2 gap-2 mt-3">
    {fuels.map((f) => {
      const active = highlightFuel === f.key;
      const tone = f.key === 'gasolina95' ? 'emerald' : 'sky';
      return (
        <div class={`rounded-xl px-3 py-2 border ${active ? (tone === 'emerald' ? 'bg-emerald-50 border-emerald-200' : 'bg-sky-50 border-sky-200') : 'bg-slate-50 border-slate-200'}`}>
          <div class="text-[10px] font-bold text-slate-600 uppercase tracking-wide">{f.label}</div>
          {f.price !== null ? (
            <div class="flex items-baseline gap-1">
              <span class="text-lg font-black text-slate-950 tabular-nums">{fmtPrice(f.price)}</span>
              <span class="text-[10px] font-bold text-slate-500">€/L</span>
            </div>
          ) : (
            <div class="text-xs text-slate-400 font-medium py-1">No disponible</div>
          )}
          {f.diff !== null && Math.abs(f.diff) >= 0.001 && (
            <div class={`text-[10px] font-bold tabular-nums ${f.diff < 0 ? 'text-emerald-700' : 'text-rose-600'}`}>
              {f.diff < 0 ? '▼' : '▲'} {fmtPrice(Math.abs(f.diff))} vs media
            </div>
          )}
        </div>
      );
    })}
  </div>

  <span class="mt-3 inline-flex items-center justify-center gap-1.5 w-full py-2 rounded-xl bg-slate-900 text-white text-xs font-bold group-hover:bg-emerald-700 transition-colors">
    Ver precios y ficha completa
    <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
  </span>
</a>

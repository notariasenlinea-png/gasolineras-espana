---
// Fondo de la portada: carretera de noche en perspectiva (SVG estático).
// Solo decoración (aria-hidden).
const W = 1000;
const H = 620;
const cx = 500;
const halfNear = 380; // media anchura de la calzada en primer plano
const proj = (z: number) => 1 / z; // z=1 primer plano, z→∞ horizonte
const px = (x: number, z: number) => cx + x * proj(z);
const py = (z: number) => H * proj(z);

// Discontinua central: tramos de 3 unidades con huecos de 3
const dashes: string[] = [];
for (let z = 1; z < 40; z += 6) {
  const z2 = z + 3;
  const w = 9;
  dashes.push(`${px(-w, z)},${py(z)} ${px(w, z)},${py(z)} ${px(w, z2)},${py(z2)} ${px(-w, z2)},${py(z2)}`);
}
const edge = (side: number) => {
  const a = side * (halfNear - 18);
  const b = side * (halfNear - 34);
  return `${px(a, 1)},${py(1)} ${px(b, 1)},${py(1)} ${cx},0 ${cx},0`;
};
const road = `${px(-halfNear, 1)},${H} ${px(halfNear, 1)},${H} ${cx + 2},0 ${cx - 2},0`;
---

<div class="road-scene absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
  <div class="sky absolute inset-0"></div>
  <div class="absolute inset-0 texture"></div>
  <div class="glow absolute"></div>
  <svg class="road-svg absolute bottom-0" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMax meet">
    <defs>
      <linearGradient id="rs-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#fff" stop-opacity="0" />
        <stop offset="0.35" stop-color="#fff" stop-opacity="0.9" />
        <stop offset="1" stop-color="#fff" stop-opacity="1" />
      </linearGradient>
      <mask id="rs-mask"><rect width={W} height={H} fill="url(#rs-fade)" /></mask>
      <linearGradient id="rs-asphalt" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#1a1f27" />
        <stop offset="0.5" stop-color="#29303b" />
        <stop offset="1" stop-color="#1a1f27" />
      </linearGradient>
    </defs>
    <g mask="url(#rs-mask)">
      <polygon points={road} fill="url(#rs-asphalt)" />
      <polygon points={edge(-1)} fill="rgba(255,255,255,.8)" />
      <polygon points={edge(1)} fill="rgba(255,255,255,.8)" />
      <g class="dashes">
        {dashes.map((d) => <polygon points={d} fill="#FFC21A" />)}
      </g>
    </g>
  </svg>
  <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-ink to-transparent"></div>
</div>

<style>
  .sky {
    background:
      radial-gradient(90% 60% at 72% 0%, rgba(27, 79, 168, 0.85) 0%, rgba(12, 38, 87, 0.7) 38%, rgba(20, 24, 31, 0) 72%),
      linear-gradient(180deg, #0c2657 0%, #14181f 70%);
  }
  .glow {
    right: 4%;
    top: 34%;
    width: 38rem;
    height: 24rem;
    background: radial-gradient(closest-side, rgba(255, 194, 26, 0.14), transparent);
  }
  .road-svg {
    left: 50%;
    width: 1300px;
    height: 70%;
    transform: translateX(-50%);
    opacity: 0.35;
  }
  @media (min-width: 1024px) {
    .road-svg {
      left: 62%;
      width: 1200px;
      height: 78%;
      opacity: 0.95;
    }
  }
  .dashes {
    animation: dash-glow 3.2s ease-in-out infinite;
  }
  @keyframes dash-glow {
    0%, 100% { opacity: 0.85; }
    50% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dashes { animation: none; }
  }
</style>

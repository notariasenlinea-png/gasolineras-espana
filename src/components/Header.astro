---
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props {
  active?: 'home' | 'mapa' | 'gasolina-95' | 'diesel' | 'provincias' | '';
}
const { active = '' } = Astro.props;

const nav = [
  { id: 'mapa', label: 'Mapa', href: '/mapa/' },
  { id: 'gasolina-95', label: 'Gasolina 95', href: '/gasolina-95/' },
  { id: 'diesel', label: 'Diésel', href: '/diesel/' },
  { id: 'provincias', label: 'Provincias', href: '/provincias/' },
];
---

<header class="sticky top-0 z-[1000] bg-paper/85 backdrop-blur-xl border-b border-ink-100/80">
  <div class="wrap h-16 flex items-center justify-between gap-4">
    <a href="/" aria-label="Gasolineras en Línea, inicio" class="rounded-xl">
      <Logo />
    </a>

    <nav class="hidden md:flex items-center gap-1" aria-label="Principal">
      {nav.map((n) => (
        <a
          href={n.href}
          class={`h-10 px-4 inline-flex items-center rounded-xl text-[14px] font-medium transition-colors ${
            active === n.id ? 'bg-ink text-white' : 'text-ink-600 hover:bg-ink-50 hover:text-ink'
          }`}
          aria-current={active === n.id ? 'page' : undefined}
        >
          {n.label}
        </a>
      ))}
    </nav>

    <a href="/?cerca=1#buscar" data-nav="cerca" class="btn-volt h-10 px-4 text-[14px]">
      <Icon name="locate" class="w-4 h-4" />
      <span class="hidden sm:inline">Cerca de mí</span>
      <span class="sm:hidden">Cerca</span>
    </a>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLAnchorElement>('header a[data-nav="cerca"]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const finder = document.getElementById('buscar');
      const gpsBtn = document.getElementById('btn-gps-locate');
      if (finder && gpsBtn) {
        e.preventDefault();
        finder.scrollIntoView({ behavior: 'smooth', block: 'start' });
        gpsBtn.click();
      }
    });
  });
</script>

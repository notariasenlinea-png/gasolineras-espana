---
interface Props {
  avgGasolina95: number;
  minGasolina95: number;
  avgDiesel: number;
  minDiesel: number;
  scope?: string;
}

const { avgGasolina95, minGasolina95, avgDiesel, minDiesel, scope = 'España' } = Astro.props;
const data = JSON.stringify({ g95: [avgGasolina95, minGasolina95], diesel: [avgDiesel, minDiesel] });
---

<section class="calc card overflow-hidden" data-prices={data} aria-labelledby="calc-title">
  <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_1fr]">
    <div class="p-6 sm:p-10">
      <p class="sign mb-4">Calculadora de ahorro</p>
      <h2 id="calc-title" class="text-3xl sm:text-[2.6rem] font-extrabold leading-[1.05] mb-3">¿Cuánto te ahorras al año?</h2>
      <p class="text-[15px] text-ink-500 mb-8 max-w-md">Repostando en la más barata en lugar de una gasolinera de precio medio en {scope}.</p>

      <div class="space-y-7">
        <div class="seg" role="group" aria-label="Combustible">
          <button type="button" class="calc-fuel" data-fuel="g95" aria-pressed="true">Gasolina 95</button>
          <button type="button" class="calc-fuel" data-fuel="diesel" aria-pressed="false">Diésel</button>
        </div>
        <label class="block">
          <span class="flex justify-between text-[14px] font-semibold mb-3">Depósito <output id="calc-tank-label" class="font-display font-extrabold">50 L</output></span>
          <input id="calc-tank-slider" type="range" min="30" max="100" step="5" value="50" class="w-full" />
        </label>
        <label class="block">
          <span class="flex justify-between text-[14px] font-semibold mb-3">Depósitos al mes <output id="calc-refills-label" class="font-display font-extrabold">2</output></span>
          <input id="calc-refills-slider" type="range" min="1" max="8" step="1" value="2" class="w-full" />
        </label>
      </div>
    </div>

    <!-- Surtidor -->
    <div class="relative bg-road p-5 sm:p-8 flex items-center">
      <div class="absolute inset-0 texture opacity-60 pointer-events-none" aria-hidden="true"></div>
      <div class="relative w-full rounded-2xl bg-ink p-2.5 shadow-totem">
        <div class="flex items-center justify-between rounded-xl bg-white/[0.04] px-4 py-2.5">
          <p class="font-display text-[12px] font-extrabold uppercase tracking-[0.14em] text-white/70">Ahorro estimado al año</p>
          <span class="w-2.5 h-2.5 rounded-full bg-volt shadow-[0_0_12px_#FFC21A]" aria-hidden="true"></span>
        </div>
        <div class="mt-2.5 rounded-xl bg-led-panel px-5 py-5 shadow-[inset_0_2px_14px_rgba(0,0,0,.85)] flex items-end justify-end gap-3">
          <span id="calc-result-annual" class="led led-amber text-[52px] sm:text-[64px] leading-none">0</span>
          <span class="font-display text-[28px] font-extrabold text-led-amber/80 mb-1">€</span>
        </div>
        <div class="grid grid-cols-2 gap-2.5 mt-2.5">
          <div class="rounded-xl bg-white/[0.05] px-4 py-3"><span class="block text-[12px] font-semibold text-white/55">Por depósito</span><span id="calc-result-tank" class="font-display font-extrabold text-[22px] text-white tabular-nums">0 €</span></div>
          <div class="rounded-xl bg-white/[0.05] px-4 py-3"><span class="block text-[12px] font-semibold text-white/55">Al mes</span><span id="calc-result-monthly" class="font-display font-extrabold text-[22px] text-white tabular-nums">0 €</span></div>
        </div>
        <p id="calc-note" class="text-[12px] text-white/50 px-2 pt-3 pb-1"></p>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.calc').forEach((root) => {
    const prices = JSON.parse(root.dataset.prices || '{}') as Record<string, [number, number]>;
    let fuel = 'g95';
    const tank = root.querySelector<HTMLInputElement>('#calc-tank-slider')!;
    const refills = root.querySelector<HTMLInputElement>('#calc-refills-slider')!;
    const eur = (v: number, d = 2) => v.toFixed(d).replace('.', ',');

    function calc() {
      const [avg, min] = prices[fuel];
      const perL = Math.max(0, avg - min);
      const perTank = perL * Number(tank.value);
      const month = perTank * Number(refills.value);
      root.querySelector('#calc-tank-label')!.textContent = `${tank.value} L`;
      root.querySelector('#calc-refills-label')!.textContent = refills.value;
      root.querySelector('#calc-result-annual')!.textContent = Math.round(month * 12).toLocaleString('es-ES');
      root.querySelector('#calc-result-tank')!.textContent = `${eur(perTank)} €`;
      root.querySelector('#calc-result-monthly')!.textContent = `${eur(month)} €`;
      root.querySelector('#calc-note')!.textContent = `Media ${eur(avg, 3)} €/L frente a la más barata ${eur(min, 3)} €/L.`;
    }

    root.querySelectorAll<HTMLButtonElement>('.calc-fuel').forEach((b) =>
      b.addEventListener('click', () => {
        fuel = b.dataset.fuel || 'g95';
        root.querySelectorAll('.calc-fuel').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        calc();
      }),
    );
    tank.addEventListener('input', calc);
    refills.addEventListener('input', calc);
    calc();
  });
</script>

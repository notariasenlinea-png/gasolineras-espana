---
interface Props {
  avgGasolina95: number;
  minGasolina95: number;
  avgDiesel: number;
  minDiesel: number;
  scope?: string;
}

const { avgGasolina95, minGasolina95, avgDiesel, minDiesel, scope = 'España' } = Astro.props;
const data = JSON.stringify({ g95: [avgGasolina95, minGasolina95], diesel: [avgDiesel, minDiesel] });
---

<section class="calc card p-6 sm:p-10" data-prices={data} aria-labelledby="calc-title">
  <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-8 lg:gap-12 items-center">
    <div>
      <p class="eyebrow mb-3">Calculadora de ahorro</p>
      <h2 id="calc-title" class="text-3xl sm:text-4xl font-bold leading-tight mb-2">¿Cuánto te ahorras al año?</h2>
      <p class="text-[15px] text-ink-500 mb-8">Repostando en la más barata en lugar de una gasolinera de precio medio en {scope}.</p>

      <div class="space-y-7">
        <div class="seg" role="group" aria-label="Combustible">
          <button type="button" class="calc-fuel" data-fuel="g95" aria-pressed="true">Gasolina 95</button>
          <button type="button" class="calc-fuel" data-fuel="diesel" aria-pressed="false">Diésel</button>
        </div>
        <label class="block">
          <span class="flex justify-between text-[14px] font-medium mb-3">Depósito <output id="calc-tank-label" class="font-display font-bold">50 L</output></span>
          <input id="calc-tank-slider" type="range" min="30" max="100" step="5" value="50" class="w-full accent-ink" />
        </label>
        <label class="block">
          <span class="flex justify-between text-[14px] font-medium mb-3">Depósitos al mes <output id="calc-refills-label" class="font-display font-bold">2</output></span>
          <input id="calc-refills-slider" type="range" min="1" max="8" step="1" value="2" class="w-full accent-ink" />
        </label>
      </div>
    </div>

    <div class="rounded-[28px] bg-volt p-7 sm:p-9">
      <p class="text-[14px] font-semibold text-ink-700">Ahorro estimado al año</p>
      <p class="font-display font-extrabold tabular-nums text-6xl sm:text-7xl tracking-tight my-2"><span id="calc-result-annual">0</span> €</p>
      <div class="grid grid-cols-2 gap-4 pt-5 mt-5 border-t border-ink/10 text-[14px]">
        <div><span class="block text-ink-600">Por depósito</span><span id="calc-result-tank" class="font-display font-bold text-xl tabular-nums">0 €</span></div>
        <div><span class="block text-ink-600">Al mes</span><span id="calc-result-monthly" class="font-display font-bold text-xl tabular-nums">0 €</span></div>
      </div>
      <p id="calc-note" class="text-[12px] text-ink-600 mt-5"></p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.calc').forEach((root) => {
    const prices = JSON.parse(root.dataset.prices || '{}') as Record<string, [number, number]>;
    let fuel = 'g95';
    const tank = root.querySelector<HTMLInputElement>('#calc-tank-slider')!;
    const refills = root.querySelector<HTMLInputElement>('#calc-refills-slider')!;
    const eur = (v: number, d = 2) => v.toFixed(d).replace('.', ',');

    function calc() {
      const [avg, min] = prices[fuel];
      const perL = Math.max(0, avg - min);
      const perTank = perL * Number(tank.value);
      const month = perTank * Number(refills.value);
      root.querySelector('#calc-tank-label')!.textContent = `${tank.value} L`;
      root.querySelector('#calc-refills-label')!.textContent = refills.value;
      root.querySelector('#calc-result-annual')!.textContent = Math.round(month * 12).toLocaleString('es-ES');
      root.querySelector('#calc-result-tank')!.textContent = `${eur(perTank)} €`;
      root.querySelector('#calc-result-monthly')!.textContent = `${eur(month)} €`;
      root.querySelector('#calc-note')!.textContent = `Media ${eur(avg, 3)} €/L frente a la más barata ${eur(min, 3)} €/L.`;
    }

    root.querySelectorAll<HTMLButtonElement>('.calc-fuel').forEach((b) =>
      b.addEventListener('click', () => {
        fuel = b.dataset.fuel || 'g95';
        root.querySelectorAll('.calc-fuel').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        calc();
      }),
    );
    tank.addEventListener('input', calc);
    refills.addEventListener('input', calc);
    calc();
  });
</script>

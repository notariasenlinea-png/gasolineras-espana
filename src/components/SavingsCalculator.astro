---
interface Props {
  avgGasolina95: number;
  minGasolina95: number;
  avgDiesel: number;
  minDiesel: number;
}

const {
  avgGasolina95 = 1.65,
  minGasolina95 = 1.35,
  avgDiesel = 1.55,
  minDiesel = 1.25,
} = Astro.props;
---

<section class="my-12 sm:my-16 bg-white rounded-3xl border border-slate-200/90 shadow-soft-card p-6 sm:p-10 relative overflow-hidden">
  <!-- Subtle decorative accents -->
  <div class="absolute top-0 right-0 w-64 h-64 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-64 h-64 bg-sky-500/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-4xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold uppercase tracking-wider mb-2">
        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Simulador de Ahorro
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
        ¿Cuánto Puedes Ahorrar al Año Eligiendo la Gasolinera Más Barata?
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 mt-2">
        Calcula el ahorro directo en tu bolsillo comparando el precio medio nacional frente a las estaciones más económicas.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <!-- Input Controls -->
      <div class="lg:col-span-7 space-y-6">
        <!-- Fuel Type Selector -->
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
            1. Tipo de Carburante
          </label>
          <div class="grid grid-cols-2 gap-3">
            <button
              id="calc-fuel-95"
              type="button"
              class="py-3 px-4 rounded-xl border-2 border-emerald-600 bg-emerald-50 text-emerald-900 font-extrabold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all cursor-pointer shadow-2xs"
            >
              <span class="w-3 h-3 rounded-full bg-emerald-600"></span>
              Gasolina 95
            </button>
            <button
              id="calc-fuel-diesel"
              type="button"
              class="py-3 px-4 rounded-xl border-2 border-slate-200 bg-slate-50 text-slate-700 font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all hover:bg-slate-100 cursor-pointer"
            >
              <span class="w-3 h-3 rounded-full bg-sky-500"></span>
              Diésel (Gasóleo A)
            </button>
          </div>
        </div>

        <!-- Tank Size Slider -->
        <div>
          <div class="flex items-center justify-between text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
            <span>2. Capacidad del Depósito</span>
            <span id="calc-tank-label" class="text-emerald-700 font-black text-sm">50 Litros</span>
          </div>
          <input
            id="calc-tank-slider"
            type="range"
            min="35"
            max="100"
            step="5"
            value="50"
            class="w-full h-2.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-emerald-600"
          />
          <div class="flex justify-between text-[11px] text-slate-400 mt-1 font-semibold">
            <span>35L (Utilitario)</span>
            <span>50L (Compacto/SUV)</span>
            <span>70L+ (Furgoneta/Grande)</span>
          </div>
        </div>

        <!-- Refills Per Month Slider -->
        <div>
          <div class="flex items-center justify-between text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
            <span>3. Depósitos Llenos al Mes</span>
            <span id="calc-refills-label" class="text-emerald-700 font-black text-sm">2 al mes</span>
          </div>
          <input
            id="calc-refills-slider"
            type="range"
            min="1"
            max="8"
            step="1"
            value="2"
            class="w-full h-2.5 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-emerald-600"
          />
          <div class="flex justify-between text-[11px] text-slate-400 mt-1 font-semibold">
            <span>1 (Uso ocasional)</span>
            <span>2 (~1.200 km/mes)</span>
            <span>4 (~2.500 km/mes)</span>
            <span>8 (Profesional)</span>
          </div>
        </div>
      </div>

      <!-- Result Card Display -->
      <div class="lg:col-span-5 bg-gradient-to-br from-slate-900 to-emerald-950 rounded-2xl p-6 text-white shadow-xl border border-slate-800 flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 block mb-1">
            Tu Ahorro Estimado
          </span>
          <div class="my-4">
            <span class="text-xs text-slate-400 font-semibold block">Ahorro Anual Total</span>
            <div class="flex items-baseline gap-1 mt-1">
              <span id="calc-result-annual" class="text-4xl sm:text-5xl font-black text-emerald-400 tracking-tight tabular-nums">
                0,00
              </span>
              <span class="text-xl font-bold text-emerald-300">€/año</span>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-4 border-t border-slate-800">
            <div>
              <span class="text-[11px] text-slate-400 block">Por Depósito:</span>
              <span id="calc-result-tank" class="text-lg font-black text-white tabular-nums">0,00 €</span>
            </div>
            <div>
              <span class="text-[11px] text-slate-400 block">Al Mes:</span>
              <span id="calc-result-monthly" class="text-lg font-black text-white tabular-nums">0,00 €</span>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-800/80">
          <p class="text-[11px] text-slate-400 leading-normal">
            Calculado con diferencia real entre media nacional (<span id="calc-current-avg">{avgGasolina95.toFixed(3)}</span>€) y mínimo nacional (<span id="calc-current-min">{minGasolina95.toFixed(3)}</span>€).
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ avgGasolina95, minGasolina95, avgDiesel, minDiesel }}>
  let fuelType = 'gasolina95';
  let tankCapacity = 50;
  let refillsPerMonth = 2;

  const btn95 = document.getElementById('calc-fuel-95');
  const btnDiesel = document.getElementById('calc-fuel-diesel');
  const tankSlider = document.getElementById('calc-tank-slider');
  const tankLabel = document.getElementById('calc-tank-label');
  const refillsSlider = document.getElementById('calc-refills-slider');
  const refillsLabel = document.getElementById('calc-refills-label');

  const resultAnnual = document.getElementById('calc-result-annual');
  const resultTank = document.getElementById('calc-result-tank');
  const resultMonthly = document.getElementById('calc-result-monthly');
  const currentAvgLabel = document.getElementById('calc-current-avg');
  const currentMinLabel = document.getElementById('calc-current-min');

  function calculateSavings() {
    const avgPrice = fuelType === 'gasolina95' ? avgGasolina95 : avgDiesel;
    const minPrice = fuelType === 'gasolina95' ? minGasolina95 : minDiesel;
    const diffPerLitre = Math.max(0, avgPrice - minPrice);

    const savingPerTank = diffPerLitre * tankCapacity;
    const savingMonthly = savingPerTank * refillsPerMonth;
    const savingAnnual = savingMonthly * 12;

    if (resultAnnual) resultAnnual.textContent = savingAnnual.toFixed(2);
    if (resultTank) resultTank.textContent = `${savingPerTank.toFixed(2)} €`;
    if (resultMonthly) resultMonthly.textContent = `${savingMonthly.toFixed(2)} €`;
    if (currentAvgLabel) currentAvgLabel.textContent = avgPrice.toFixed(3);
    if (currentMinLabel) currentMinLabel.textContent = minPrice.toFixed(3);
  }

  if (btn95 && btnDiesel) {
    btn95.addEventListener('click', () => {
      fuelType = 'gasolina95';
      btn95.className = 'py-3 px-4 rounded-xl border-2 border-emerald-600 bg-emerald-50 text-emerald-900 font-extrabold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all cursor-pointer shadow-2xs';
      btnDiesel.className = 'py-3 px-4 rounded-xl border-2 border-slate-200 bg-slate-50 text-slate-700 font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all hover:bg-slate-100 cursor-pointer';
      calculateSavings();
    });

    btnDiesel.addEventListener('click', () => {
      fuelType = 'diesel';
      btnDiesel.className = 'py-3 px-4 rounded-xl border-2 border-sky-600 bg-sky-50 text-sky-900 font-extrabold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all cursor-pointer shadow-2xs';
      btn95.className = 'py-3 px-4 rounded-xl border-2 border-slate-200 bg-slate-50 text-slate-700 font-bold text-xs sm:text-sm flex items-center justify-center gap-2 transition-all hover:bg-slate-100 cursor-pointer';
      calculateSavings();
    });
  }

  if (tankSlider && tankLabel) {
    tankSlider.addEventListener('input', (e) => {
      tankCapacity = parseInt(e.target.value, 10);
      tankLabel.textContent = `${tankCapacity} Litros`;
      calculateSavings();
    });
  }

  if (refillsSlider && refillsLabel) {
    refillsSlider.addEventListener('input', (e) => {
      refillsPerMonth = parseInt(e.target.value, 10);
      refillsLabel.textContent = `${refillsPerMonth} al mes`;
      calculateSavings();
    });
  }

  // Initial calculation
  calculateSavings();
</script>

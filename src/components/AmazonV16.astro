---
// AmazonV16.astro - Recomendación sutil de seguridad vial y balizas V16 con StoreID bricopiso-21
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const amazonUrl = "https://www.amazon.es/s?k=baliza+v16+homologada+dgt+conectada&tag=bricopiso-21";
---

{compact ? (
  <aside class="my-6 rounded-2xl bg-gradient-to-br from-amber-500/10 via-orange-500/5 to-slate-900/5 border border-amber-300 p-5 text-left">
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-amber-500/15 text-amber-950 font-bold text-[10px] border border-amber-300 uppercase tracking-wider">
        🚨 DGT Obligatorio
      </span>
      <span class="text-xs font-semibold text-slate-700 bg-white px-2 py-0.5 rounded-full border border-slate-200">
        ★★★★★ 4.9/5
      </span>
    </div>
    <h4 class="font-bold text-slate-900 text-sm mb-1 leading-snug">
      Luz V16 Homologada Conectada 3.0
    </h4>
    <p class="text-xs text-slate-600 mb-3 leading-relaxed">
      Sustituye a los triángulos. Conexión prepagada DGT 3.0 hasta 2038 y visibilidad a 1 km sin salir del vehículo.
    </p>
    <a
      href={amazonUrl}
      target="_blank"
      rel="nofollow sponsored noopener"
      class="inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 rounded-xl bg-[#FF9900] hover:bg-[#F08804] text-slate-950 font-bold text-xs shadow-sm transition-all"
    >
      <span>🛒 Ver en Amazon</span>
      <span aria-hidden="true">↗</span>
    </a>
  </aside>
) : (
  <section class="my-10 rounded-3xl bg-gradient-to-br from-amber-500/[0.08] via-orange-500/[0.04] to-slate-900/[0.03] border border-amber-300/90 shadow-sm p-6 sm:p-8 overflow-hidden text-left relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-0">
      <div class="lg:col-span-8 space-y-3">
        <div class="flex flex-wrap items-center gap-2.5 mb-1">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/15 text-amber-950 font-bold text-xs border border-amber-300/80">
            <span>🛡️</span>
            <span>SEGURIDAD EN CARRETERA · DGT 3.0</span>
          </span>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 bg-white px-3 py-1 rounded-full border border-slate-200 shadow-2xs">
            <span class="text-amber-500">★★★★★</span>
            <span>4.9/5 en Amazon</span>
          </span>
        </div>

        <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight leading-snug">
          Baliza Luz V16 Homologada con Geolocalización Conectada DGT 3.0
        </h2>
        
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-3xl">
          La nueva señalización luminosa de emergencia sustituye legalmente a los triángulos en carretera y es obligatoria para circular y pasar la ITV. En caso de avería o pinchazo, avisa automáticamente a los servicios de auxilio y tráfico en tiempo real sin tener que bajarte del coche en el arcén.
        </p>

        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-2 text-xs text-slate-700">
          <li class="flex items-center gap-2 bg-white/80 p-2 rounded-xl border border-amber-200/70">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Conexión eSIM DGT 3.0 sin cuotas hasta 2038</span>
          </li>
          <li class="flex items-center gap-2 bg-white/80 p-2 rounded-xl border border-amber-200/70">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Fijación magnética al techo en 3 segundos</span>
          </li>
          <li class="flex items-center gap-2 bg-white/80 p-2 rounded-xl border border-amber-200/70">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Visibilidad 360° a más de 1 km de distancia</span>
          </li>
          <li class="flex items-center gap-2 bg-white/80 p-2 rounded-xl border border-amber-200/70">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Evita multas de 200 € y supera la ITV</span>
          </li>
        </ul>
      </div>

      <div class="lg:col-span-4 flex flex-col items-center justify-center space-y-3 bg-white/95 p-6 rounded-2xl border border-amber-200/90 shadow-2xs text-center">
        <div class="text-4xl">🚨📡</div>
        <h3 class="text-base font-bold text-slate-900">
          Luz V16 Homologada DGT 3.0
        </h3>
        <p class="text-xs text-slate-500 leading-normal">
          Compara los modelos homologados oficiales con mejor relación calidad-precio y entrega Prime.
        </p>
        <a
          href={amazonUrl}
          target="_blank"
          rel="nofollow sponsored noopener"
          class="inline-flex items-center justify-center gap-2 w-full px-5 py-3.5 rounded-xl bg-[#FF9900] hover:bg-[#F08804] text-slate-950 font-black text-xs sm:text-sm shadow-md transition-all text-center"
        >
          <span>🛒 Ver Balizas V16 en Amazon</span>
          <span aria-hidden="true">↗</span>
        </a>
        <small class="text-[10px] text-slate-400">
          ✓ Envío Prime en 24h · Devolución garantizada en Amazon
        </small>
      </div>
    </div>
  </section>
)}

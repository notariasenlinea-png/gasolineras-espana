---
// Monolito de precios: el cartel luminoso que hay a la entrada de cada
// gasolinera española. Cabecera azul, filas con la etiqueta del carburante
// y ventanas LED con el precio.
import LedPrice from './LedPrice.astro';

interface Props {
  title: string;
  subtitle?: string;
  rows: Array<{ label: string; price: number | null; dot: string; note?: string }>;
  footer?: string;
  class?: string;
  /** Dibuja el poste y la base (versión portada) */
  pole?: boolean;
}

const { title, subtitle, rows, footer, class: className = '', pole = false } = Astro.props;
const light = (hex: string) => /^#(e|f|d)/i.test(hex);
---

<div class={`totem relative ${className}`}>
  <div class="relative rounded-[18px] bg-[#0B0E13] p-2.5 shadow-totem ring-1 ring-black/40">
    <div class="rounded-[12px] bg-road px-4 pt-3 pb-3 shadow-sign">
      <div class="flex items-center justify-between gap-3">
        <p class="font-display font-extrabold text-white text-[15px] leading-tight truncate">{title}</p>
        <span class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-[0.12em] text-white/75 shrink-0"><span class="live-dot"></span>En directo</span>
      </div>
      {subtitle && <p class="text-[12px] text-white/85 truncate mt-0.5">{subtitle}</p>}
    </div>
    <ul class="mt-2.5 space-y-2">
      {rows.map((r) => (
        <li class="grid grid-cols-[minmax(0,1fr)_auto] items-stretch gap-2">
          <span class="flex items-center gap-2.5 min-w-0 rounded-[10px] bg-white px-3 py-2">
            <span class={`shrink-0 w-2.5 self-stretch rounded-sm ${light(r.dot) ? 'ring-1 ring-ink-300' : ''}`} style={`background:${r.dot}`}></span>
            <span class="min-w-0">
              <span class="block font-display text-[13.5px] font-extrabold uppercase tracking-[0.02em] text-ink truncate">{r.label}</span>
              {r.note && <span class="block text-[11px] text-ink-500 truncate">{r.note}</span>}
            </span>
          </span>
          <span class="flex items-end gap-1.5 rounded-[10px] bg-led-panel ring-1 ring-white/[0.06] px-3 pt-2.5 pb-2 shadow-[inset_0_2px_10px_rgba(0,0,0,.8)]">
            <LedPrice price={r.price} class="text-[28px] sm:text-[34px]" />
            <span class="text-[10px] font-bold text-white/60 mb-0.5">€/L</span>
          </span>
        </li>
      ))}
    </ul>
    {footer && <p class="px-2 pt-2.5 pb-0.5 text-[11px] text-white/45">{footer}</p>}
  </div>
  {pole && (
    <div class="relative mx-auto w-[34%] h-16 sm:h-24 -mt-px" aria-hidden="true">
      <div class="absolute inset-x-[30%] top-0 bottom-3 bg-gradient-to-r from-[#1c2129] via-[#3a424f] to-[#1c2129]"></div>
      <div class="absolute inset-x-0 bottom-0 h-3 rounded-t-md bg-gradient-to-b from-[#2c333d] to-[#14181f]"></div>
    </div>
  )}
</div>

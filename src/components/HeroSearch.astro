---
// Search-first hero: autocompletado (municipio, CP, provincia, marca) + GPS "cerca de mí".
const filters = [
  { id: 'all', label: 'Todas' },
  { id: '24h', label: 'Solo 24 horas' },
  { id: 'g95', label: 'Gasolina 95' },
  { id: 'diesel', label: 'Diésel' },
  { id: 'lowcost', label: 'Low-cost / Automáticas' },
];
---

<div id="cerca-de-mi" class="scroll-mt-24 w-full max-w-2xl mx-auto text-left">
  <!-- Search box -->
  <div class="relative">
    <label for="hero-search" class="sr-only">Buscar por municipio, código postal, provincia o marca</label>
    <svg class="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      id="hero-search"
      type="search"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="hero-search-results"
      placeholder="Municipio, código postal o marca (ej. Getafe, 28001, Repsol)"
      class="w-full h-14 pl-12 pr-4 rounded-2xl border border-slate-300 bg-white text-base text-slate-900 placeholder:text-slate-400 shadow-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500"
    />
    <ul
      id="hero-search-results"
      role="listbox"
      class="hidden absolute z-40 mt-2 w-full max-h-96 overflow-y-auto rounded-2xl border border-slate-200 bg-white shadow-lg py-2"
    ></ul>
  </div>

  <!-- GPS + filters -->
  <div class="mt-4 flex flex-col sm:flex-row sm:items-center gap-3">
    <button
      id="btn-gps-locate"
      type="button"
      class="inline-flex items-center justify-center gap-2 h-12 px-5 rounded-2xl bg-emerald-600 hover:bg-emerald-700 disabled:opacity-60 text-white text-sm font-black shadow-sm transition-colors shrink-0"
    >
      <span id="gps-icon" aria-hidden="true">📍</span>
      <span id="btn-gps-text">Gasolineras cerca de mí</span>
    </button>
    <div class="flex gap-2 overflow-x-auto pb-1 sm:pb-0 -mx-1 px-1" role="group" aria-label="Filtros rápidos">
      {filters.map((f, i) => (
        <button
          type="button"
          data-filter={f.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
          class="hero-filter shrink-0 px-3 py-2 rounded-full text-xs font-bold border transition-colors aria-pressed:bg-slate-900 aria-pressed:text-white aria-pressed:border-slate-900 bg-white text-slate-700 border-slate-300 hover:border-slate-500"
        >
          {f.label}
        </button>
      ))}
    </div>
  </div>

  <p id="gps-status-box" class="hidden mt-3 text-xs font-semibold text-slate-600" aria-live="polite"></p>
  <ol id="gps-results" class="hidden mt-3 space-y-2"></ol>
</div>

<script>
  import { isLowCost, lightStationUrl, type StationLight } from '../lib/stations';

  type SearchIndex = {
    p: Array<[string, string, number]>;
    m: Array<[string, string, string, number, string]>;
    b: Array<[string, number]>;
  };
  type Item = { label: string; sub: string; href?: string; brand?: string; tag: string };
  type Filter = 'all' | '24h' | 'g95' | 'diesel' | 'lowcost';

  const input = document.getElementById('hero-search') as HTMLInputElement | null;
  const list = document.getElementById('hero-search-results') as HTMLUListElement | null;
  const btnGps = document.getElementById('btn-gps-locate') as HTMLButtonElement | null;
  const btnGpsText = document.getElementById('btn-gps-text');
  const statusBox = document.getElementById('gps-status-box');
  const results = document.getElementById('gps-results');

  const norm = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
  const price = (p: number | null) => (p === null ? '–' : p.toFixed(3).replace('.', ','));

  let indexPromise: Promise<SearchIndex> | null = null;
  let stationsPromise: Promise<StationLight[]> | null = null;
  const loadIndex = () => (indexPromise ??= fetch('/data/search-index.json').then((r) => r.json()));
  const loadStations = () => (stationsPromise ??= fetch('/data/stations_light.json').then((r) => r.json()));

  let items: Item[] = [];
  let active = -1;
  let userPos: { lat: number; lng: number } | null = null;
  let filter: Filter = 'all';

  /* ---------------- Autocomplete ---------------- */

  function score(name: string, q: string): number {
    const n = norm(name);
    if (n === q) return 0;
    if (n.startsWith(q)) return 1;
    if (n.split(/[\s-]+/).some((w) => w.startsWith(q))) return 2;
    if (n.includes(q)) return 3;
    return -1;
  }

  async function search(raw: string): Promise<Item[]> {
    const q = norm(raw);
    if (q.length < 2) return [];
    const idx = await loadIndex();
    const out: Item[] = [];

    if (/^\d{2,5}$/.test(q)) {
      for (const [name, prov, href, count, cps] of idx.m) {
        const cp = cps.split(' ').find((c) => c.startsWith(q));
        if (cp) out.push({ label: name, sub: `CP ${cp} · ${prov} · ${count} gasolineras`, href, tag: 'Municipio' });
        if (out.length >= 8) break;
      }
      return out;
    }

    const brandHits = idx.b
      .map(([name, count]) => ({ name, count, s: score(name, q) }))
      .filter((b) => b.s >= 0 && b.s <= 2)
      .slice(0, 2)
      .map((b) => ({ label: b.name, sub: `Ver las ${b.count} gasolineras ${b.name} más baratas`, brand: b.name, tag: 'Marca' }));

    const provHits = idx.p
      .map(([name, href, count]) => ({ name, href, count, s: score(name, q) }))
      .filter((p) => p.s >= 0)
      .sort((a, b) => a.s - b.s)
      .slice(0, 3)
      .map((p) => ({ label: p.name, sub: `Provincia · ${p.count} gasolineras`, href: p.href, tag: 'Provincia' }));

    const muniHits = idx.m
      .map(([name, prov, href, count]) => ({ name, prov, href, count, s: score(name, q) }))
      .filter((m) => m.s >= 0)
      .sort((a, b) => a.s - b.s || b.count - a.count)
      .slice(0, 7)
      .map((m) => ({ label: m.name, sub: `${m.prov} · ${m.count} ${m.count === 1 ? 'gasolinera' : 'gasolineras'}`, href: m.href, tag: 'Municipio' }));

    return [...muniHits, ...provHits, ...brandHits].slice(0, 10);
  }

  function renderSuggestions() {
    if (!list || !input) return;
    list.replaceChildren();
    if (items.length === 0) {
      list.classList.add('hidden');
      input.setAttribute('aria-expanded', 'false');
      return;
    }
    items.forEach((it, i) => {
      const li = document.createElement('li');
      li.id = `hero-opt-${i}`;
      li.setAttribute('role', 'option');
      li.setAttribute('aria-selected', String(i === active));
      li.className = `flex items-center justify-between gap-3 px-4 py-2.5 cursor-pointer ${i === active ? 'bg-emerald-50' : 'hover:bg-slate-50'}`;
      const left = document.createElement('div');
      left.className = 'min-w-0';
      const title = document.createElement('div');
      title.className = 'text-sm font-bold text-slate-900 truncate';
      title.textContent = it.label;
      const sub = document.createElement('div');
      sub.className = 'text-xs text-slate-500 truncate';
      sub.textContent = it.sub;
      left.append(title, sub);
      const tag = document.createElement('span');
      tag.className = 'shrink-0 text-[10px] font-bold uppercase tracking-wide text-slate-500 bg-slate-100 rounded-md px-2 py-0.5';
      tag.textContent = it.tag;
      li.append(left, tag);
      li.addEventListener('mousedown', (e) => {
        e.preventDefault();
        choose(it);
      });
      list.appendChild(li);
    });
    list.classList.remove('hidden');
    input.setAttribute('aria-expanded', 'true');
    input.setAttribute('aria-activedescendant', active >= 0 ? `hero-opt-${active}` : '');
  }

  function closeSuggestions() {
    items = [];
    active = -1;
    renderSuggestions();
  }

  function choose(it: Item) {
    if (it.href) {
      window.location.href = it.href;
    } else if (it.brand) {
      closeSuggestions();
      if (input) input.value = it.brand;
      showBrand(it.brand);
    }
  }

  let debounce: number | undefined;
  input?.addEventListener('focus', () => loadIndex());
  input?.addEventListener('input', () => {
    window.clearTimeout(debounce);
    debounce = window.setTimeout(async () => {
      items = await search(input.value);
      active = items.length ? 0 : -1;
      renderSuggestions();
    }, 90);
  });
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' && items.length) {
      e.preventDefault();
      active = (active + 1) % items.length;
      renderSuggestions();
    } else if (e.key === 'ArrowUp' && items.length) {
      e.preventDefault();
      active = (active - 1 + items.length) % items.length;
      renderSuggestions();
    } else if (e.key === 'Enter' && active >= 0 && items[active]) {
      e.preventDefault();
      choose(items[active]);
    } else if (e.key === 'Escape') {
      closeSuggestions();
    }
  });
  input?.addEventListener('blur', () => window.setTimeout(closeSuggestions, 120));

  /* ---------------- Nearby / brand results ---------------- */

  const haversine = (lat1: number, lon1: number, lat2: number, lon2: number) => {
    const R = 6371;
    const dLat = ((lat2 - lat1) * Math.PI) / 180;
    const dLon = ((lon2 - lon1) * Math.PI) / 180;
    const a = Math.sin(dLat / 2) ** 2 + Math.cos((lat1 * Math.PI) / 180) * Math.cos((lat2 * Math.PI) / 180) * Math.sin(dLon / 2) ** 2;
    return 2 * R * Math.asin(Math.sqrt(a));
  };

  function passes(s: StationLight): boolean {
    if (filter === '24h') return s.h24;
    if (filter === 'g95') return s.p95 !== null;
    if (filter === 'diesel') return s.d !== null;
    if (filter === 'lowcost') return isLowCost(s.b);
    return s.p95 !== null || s.d !== null;
  }

  function setStatus(text: string) {
    if (!statusBox) return;
    statusBox.textContent = text;
    statusBox.classList.toggle('hidden', !text);
  }

  function renderStations(rows: Array<StationLight & { km?: number }>) {
    if (!results) return;
    results.replaceChildren();
    for (const s of rows) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = lightStationUrl(s);
      a.className = 'flex items-center gap-3 p-3 rounded-2xl bg-white border border-slate-200 shadow-sm hover:border-emerald-500 transition-colors';

      const info = document.createElement('div');
      info.className = 'min-w-0 flex-1';
      const top = document.createElement('div');
      top.className = 'flex items-center gap-2';
      const brand = document.createElement('span');
      brand.className = 'text-sm font-extrabold text-slate-900 truncate';
      brand.textContent = s.b;
      top.appendChild(brand);
      if (s.h24) {
        const b24 = document.createElement('span');
        b24.className = 'text-[10px] font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 rounded-full px-1.5';
        b24.textContent = '24H';
        top.appendChild(b24);
      }
      const addr = document.createElement('div');
      addr.className = 'text-xs text-slate-500 truncate';
      addr.textContent = `${s.a}, ${s.t}`;
      info.append(top, addr);

      const right = document.createElement('div');
      right.className = 'text-right shrink-0 tabular-nums';
      const main = document.createElement('div');
      main.className = 'text-xs text-slate-600';
      const showDiesel = filter === 'diesel';
      const label = document.createElement('span');
      label.textContent = showDiesel ? 'Diésel ' : 'G95 ';
      const val = document.createElement('strong');
      val.className = 'text-base font-black text-slate-950';
      val.textContent = price(showDiesel ? s.d : s.p95 ?? s.d);
      main.append(label, val);
      const km = document.createElement('div');
      km.className = 'text-[11px] font-bold text-amber-700';
      km.textContent = s.km !== undefined ? `a ${s.km < 1 ? `${Math.round(s.km * 1000)} m` : `${s.km.toFixed(1).replace('.', ',')} km`}` : s.p;
      right.append(main, km);

      const arrow = document.createElement('span');
      arrow.className = 'text-slate-400';
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = '›';

      a.append(info, right, arrow);
      li.appendChild(a);
      results.appendChild(li);
    }
    results.classList.toggle('hidden', rows.length === 0);
  }

  async function showNearby() {
    if (!userPos) return;
    const all = await loadStations();
    const t0 = performance.now();
    const rows = all
      .filter(passes)
      .map((s) => ({ ...s, km: haversine(userPos!.lat, userPos!.lng, s.lt, s.ln) }))
      .sort((a, b) => a.km - b.km)
      .slice(0, 5);
    renderStations(rows);
    const ms = Math.round(performance.now() - t0);
    setStatus(rows.length ? `Las ${rows.length} gasolineras más cercanas (calculado en ${ms} ms):` : 'No hay gasolineras que cumplan el filtro cerca de ti.');
  }

  let brandMode: string | null = null;
  async function showBrand(brand: string) {
    brandMode = brand;
    const all = await loadStations();
    const key = filter === 'diesel' ? 'd' : 'p95';
    let rows: Array<StationLight & { km?: number }> = all.filter((s) => s.b === brand && passes(s));
    if (userPos) {
      rows = rows.map((s) => ({ ...s, km: haversine(userPos!.lat, userPos!.lng, s.lt, s.ln) })).sort((a, b) => a.km! - b.km!);
    } else {
      rows.sort((a, b) => (a[key] ?? 99) - (b[key] ?? 99));
    }
    rows = rows.slice(0, 5);
    renderStations(rows);
    setStatus(rows.length ? `${brand}: ${userPos ? 'las más cercanas a ti' : 'las más baratas de España'}` : `No hay gasolineras ${brand} con este filtro.`);
  }

  const refresh = () => (brandMode ? showBrand(brandMode) : userPos ? showNearby() : undefined);

  btnGps?.addEventListener('click', () => {
    brandMode = null;
    if (!navigator.geolocation) {
      setStatus('Tu navegador no permite geolocalización. Usa el buscador o elige tu provincia más abajo.');
      return;
    }
    btnGps.disabled = true;
    if (btnGpsText) btnGpsText.textContent = 'Localizando…';
    setStatus('Solicitando tu ubicación…');
    loadStations();
    navigator.geolocation.getCurrentPosition(
      async (pos) => {
        userPos = { lat: pos.coords.latitude, lng: pos.coords.longitude };
        await showNearby();
        btnGps.disabled = false;
        if (btnGpsText) btnGpsText.textContent = 'Actualizar ubicación';
      },
      () => {
        btnGps.disabled = false;
        if (btnGpsText) btnGpsText.textContent = 'Gasolineras cerca de mí';
        setStatus('No pudimos acceder a tu ubicación. Busca tu municipio o código postal arriba.');
      },
      { timeout: 12000, enableHighAccuracy: true, maximumAge: 60000 },
    );
  });

  document.querySelectorAll<HTMLButtonElement>('.hero-filter').forEach((btn) => {
    btn.addEventListener('click', () => {
      filter = (btn.dataset.filter as Filter) || 'all';
      document.querySelectorAll('.hero-filter').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      refresh();
    });
  });

  // Support the SearchAction target (/?q=...)
  const q = new URLSearchParams(window.location.search).get('q');
  if (q && input) {
    input.value = q;
    input.dispatchEvent(new Event('input'));
    input.focus();
  }
</script>
